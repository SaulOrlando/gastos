@model FinanzApp.Web.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Ajustes de Cuenta";
}

<div class="min-h-screen bg-[#e8f5e9] py-8 px-4 flex flex-col items-center">
    
    <div class="w-full max-w-3xl space-y-6">
        <!-- Encabezado -->
        <div>
            <h1 class="text-3xl font-bold text-[#064e3b]">Ajustes de Cuenta</h1>
            <p class="text-gray-600 text-sm mt-1">Gestiona tu perfil y preferencias financieras.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-emerald-100 border border-emerald-300 text-emerald-800 text-sm px-4 py-3 rounded-xl">
                @TempData["SuccessMessage"]
            </div>
        }

        <form id="profileSettingsForm" asp-controller="Settings" asp-action="UpdateProfile" method="post" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <!-- Card 1: Perfil -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-emerald-50">
                <h2 class="text-lg font-bold text-[#064e3b] mb-4">Perfil</h2>
                
                <div class="flex items-start gap-6">
                    <!-- Foto de Perfil -->
                    <div class="relative flex flex-col items-center gap-2">
                        <img src="@(string.IsNullOrEmpty(Model.ProfilePicture)
                                  ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.FullName)}&background=064e3b&color=fff"
                                  : Model.ProfilePicture)"
                             alt="Foto de Perfil" id="profilePreview"
                             class="w-20 h-20 rounded-full object-cover border-2 border-emerald-200" />
                        <label for="ProfilePictureFile"
                               class="text-xs font-semibold text-[#064e3b] hover:underline cursor-pointer">
                            Cambiar foto
                        </label>
                        <input type="file" id="ProfilePictureFile" name="ProfilePictureFile" accept="image/*"
                               class="hidden" onchange="previewProfilePhoto(this)" />
                    </div>

                    <!-- Campo Nombre -->
                    <div class="flex-1 space-y-4">
                        <div>
                            <label asp-for="FullName" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">NOMBRE COMPLETO</label>
                            <input asp-for="FullName" placeholder="María González"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="FullName" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">CORREO ELECTRÓNICO</label>
                            <input asp-for="Email" type="email" value="@Model.Email" disabled readonly
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-500 bg-gray-50 cursor-not-allowed" />
                            <p class="text-xs text-gray-400 mt-1">El correo es tu identificador de acceso y no se puede modificar.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Configuración de Ingresos -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-emerald-50 space-y-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#064e3b]">Configuración de Ingresos</h2>
                    <div class="relative">
                        <button type="button" id="incomeInfoToggle"
                                class="w-6 h-6 rounded-full border border-[#064e3b] text-[#064e3b] flex items-center justify-center text-xs font-bold hover:bg-emerald-50 transition-colors focus:outline-none focus:ring-2 focus:ring-[#064e3b]/40"
                                aria-label="¿Qué es la configuración de ingresos?" aria-expanded="false">
                            i
                        </button>
                        <div id="incomeInfoTooltip"
                             class="hidden absolute right-0 mt-2 w-72 rounded-xl bg-white border border-emerald-100 shadow-lg p-4 text-sm text-gray-600 z-10">
                            <p class="mb-1">
                                Aquí defines tu sueldo y cada cuánto lo recibes. Ese monto se sumará
                                automáticamente a tus ingresos según los días que indiques.
                            </p>
                            <p class="mt-1">
                                Si eliges <span class="font-semibold text-[#064e3b]">Personalizado</span>,
                                indica el día en que lo recibirías por primera vez y cada cuántos días
                                (máximo 31). Por ejemplo: primer día el 1 de noviembre y 7 días — se
                                sumará automáticamente el 8.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Monto del Sueldo -->
                <div>
                    <label asp-for="SalaryAmount" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">MONTO DEL SUELDO</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-4 text-gray-400 text-lg">$</span>
                        <input asp-for="SalaryAmount" type="number" step="0.01" placeholder="4500"
                               class="w-full rounded-xl border border-gray-200 py-3.5 pl-9 pr-4 text-lg font-semibold text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Ingresa el monto neto que recibes. Si lo dejas en $0 no se sumará ningún ingreso automático.</p>
                </div>

                <!-- Frecuencia de Depósito -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">FRECUENCIA DE DEPÓSITO</label>
                    <input type="hidden" asp-for="DepositFrequency" id="selectedFrequency" value="@Model.DepositFrequency" />

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Opción 1: Cada 15 días / Quincenal -->
                        <button type="button" data-freq="Quincenal" onclick="selectFrequency('Quincenal', this)"
                                class="freq-btn flex items-center justify-between p-4 rounded-xl border-2 border-[#064e3b] bg-emerald-50/50 text-left transition-all">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Cada 15 días</p>
                                <p class="text-sm font-bold text-[#064e3b]">Quincenal</p>
                            </div>
                            <i class="bi bi-check-circle-fill text-[#064e3b] text-lg check-icon"></i>
                        </button>

                        <!-- Opción 2: Cada mes / Mensual -->
                        <button type="button" data-freq="Mensual" onclick="selectFrequency('Mensual', this)"
                                class="freq-btn flex items-center justify-between p-4 rounded-xl border border-gray-200 bg-white text-left transition-all">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Cada mes</p>
                                <p class="text-sm font-bold text-gray-700">Mensual</p>
                            </div>
                            <i class="bi bi-circle text-gray-300 text-lg check-icon"></i>
                        </button>

                        <!-- Opción 3: Personalizado -->
                        <button type="button" data-freq="Personalizado" onclick="selectFrequency('Personalizado', this)"
                                class="freq-btn flex items-center justify-between p-4 rounded-xl border border-gray-200 bg-white text-left transition-all">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Personalizado</p>
                                <p class="text-sm font-bold text-gray-700">Días específicos</p>
                            </div>
                            <i class="bi bi-circle text-gray-300 text-lg check-icon"></i>
                        </button>
                    </div>

                    <!-- Panel Personalizado -->
                    <div id="customFrequencyPanel" class="mt-4 hidden rounded-xl border border-emerald-100 bg-emerald-50/40 p-4 space-y-4 transition-all">
                        <p class="text-sm text-[#064e3b] font-semibold flex items-center gap-2">
                            <i class="bi bi-calendar-event"></i> Frecuencia personalizada
                        </p>

                        <div>
                            <label asp-for="DepositStartDate" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">PRIMER DÍA QUE SE SUMARÁ</label>
                            <input asp-for="DepositStartDate" type="date"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="DepositStartDate" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="DepositIntervalDays" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">CADA CUÁNTOS DÍAS SE SUMA</label>
                            <input asp-for="DepositIntervalDays" type="number" min="1" max="31" placeholder="7"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="DepositIntervalDays" class="text-xs text-red-500 mt-1 block"></span>
                            <p class="text-xs text-gray-400 mt-1">Máximo 31 días. Ejemplo: primer día el 1 de noviembre y 7 días — se sumará automáticamente el 8.</p>
                        </div>
                    </div>
                </div>
            </div>

        <!-- Botón Guardar Cambios (dentro del form principal) -->
            <div class="flex justify-end pt-2">
                <button type="submit"
                        class="px-8 py-3 bg-[#064e3b] hover:bg-[#04382a] text-white font-bold text-sm rounded-full shadow-md transition-all">
                    Guardar Cambios
                </button>
            </div>
        </form>

        <!-- Card 3: Seguridad y Sesión (fuera del form de guardado para no anidar
             el form de Cerrar Sesión, lo que rompería el form principal) -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-emerald-50 space-y-6">
                <h2 class="text-lg font-bold text-[#064e3b]">Seguridad y Sesión</h2>

                <!-- Cambiar Contraseña -->
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-gray-800">Contraseña</h3>
                        <p class="text-xs text-gray-400">Última actualización hace 3 meses</p>
                    </div>
                    <button type="button" id="togglePasswordForm"
                            onclick="togglePasswordForm()"
                            class="px-4 py-2 rounded-xl border border-emerald-300 text-[#064e3b] text-xs font-semibold hover:bg-emerald-50 transition-colors">
                        Cambiar Contraseña
                    </button>
                </div>

                <div id="passwordChangePanel" class="hidden mt-4 rounded-xl border border-emerald-100 bg-emerald-50/40 p-4 space-y-4">
                    <form asp-controller="Settings" asp-action="ChangePassword" method="post" class="space-y-4">
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

                        <div>
                            <label asp-for="CurrentPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">CONTRASEÑA ACTUAL</label>
                            <input asp-for="CurrentPassword" type="password"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="CurrentPassword" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="NewPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">NUEVA CONTRASEÑA</label>
                            <input asp-for="NewPassword" type="password"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="NewPassword" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">CONFIRMAR NUEVA CONTRASEÑA</label>
                            <input asp-for="ConfirmPassword" type="password"
                                   class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-700 focus:outline-none focus:border-[#064e3b]" />
                            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <button type="submit"
                                class="px-6 py-2.5 bg-[#064e3b] hover:bg-[#04382a] text-white font-bold text-sm rounded-full shadow-md transition-all">
                            Guardar Contraseña
                        </button>
                    </form>
                </div>

                <hr class="border-gray-100" />

                <!-- Cerrar Sesión -->
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-red-500">Cerrar Sesión</h3>
                        <p class="text-xs text-gray-400">Saldrás de tu cuenta en este dispositivo.</p>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="px-4 py-2 rounded-xl border border-red-200 text-red-500 text-xs font-semibold hover:bg-red-50 transition-colors flex items-center gap-1.5">
                            <i class="bi bi-box-arrow-right"></i>
                            Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewProfilePhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('profilePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function selectFrequency(value, btn) {
            document.getElementById('selectedFrequency').value = value;

            // Resetear todos los botones de frecuencia
            document.querySelectorAll('.freq-btn').forEach(b => {
                b.classList.remove('border-2', 'border-[#064e3b]', 'bg-emerald-50/50');
                b.classList.add('border', 'border-gray-200', 'bg-white');
                
                const title = b.querySelector('.text-sm');
                if (title) {
                    title.classList.remove('text-[#064e3b]');
                    title.classList.add('text-gray-700');
                }

                const icon = b.querySelector('.check-icon');
                if (icon) {
                    icon.className = 'bi bi-circle text-gray-300 text-lg check-icon';
                }
            });

            // Activar botón clickeado
            btn.classList.remove('border-gray-200', 'bg-white');
            btn.classList.add('border-2', 'border-[#064e3b]', 'bg-emerald-50/50');

            const activeTitle = btn.querySelector('.text-sm');
            if (activeTitle) {
                activeTitle.classList.remove('text-gray-700');
                activeTitle.classList.add('text-[#064e3b]');
            }

            const activeIcon = btn.querySelector('.check-icon');
            if (activeIcon) {
                activeIcon.className = 'bi bi-check-circle-fill text-[#064e3b] text-lg check-icon';
            }

            // Mostrar/ocultar el panel de personalizado
            var panel = document.getElementById('customFrequencyPanel');
            if (panel) {
                panel.classList.toggle('hidden', value !== 'Personalizado');
            }
        }

        // Toggle del tooltip de ayuda
        (function () {
            var toggle = document.getElementById('incomeInfoToggle');
            var tooltip = document.getElementById('incomeInfoTooltip');
            if (toggle && tooltip) {
                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var hidden = tooltip.classList.toggle('hidden');
                    toggle.setAttribute('aria-expanded', String(!hidden));
                });
                document.addEventListener('click', function (e) {
                    if (!tooltip.classList.contains('hidden')) {
                        tooltip.classList.add('hidden');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        })();

        // Toggle del formulario de cambio de contraseña
        function togglePasswordForm() {
            var panel = document.getElementById('passwordChangePanel');
            if (panel) {
                var wasHidden = panel.classList.contains('hidden');
                panel.classList.toggle('hidden');
                var btn = document.getElementById('togglePasswordForm');
                if (btn) {
                    btn.textContent = wasHidden ? 'Cancelar' : 'Cambiar Contraseña';
                }
            }
        }

        // Activar la frecuencia guardada al cargar la página
        (function () {
            var saved = document.getElementById('selectedFrequency').value;
            var target = document.querySelector('.freq-btn[data-freq="' + saved + '"]');
            if (target) {
                selectFrequency(saved, target);
            } else {
                var panel = document.getElementById('customFrequencyPanel');
                if (panel) panel.classList.add('hidden');
            }
        })();
    </script>
}