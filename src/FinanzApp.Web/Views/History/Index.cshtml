@model FinanzApp.Web.ViewModels.HistoryViewModel
@{
    ViewData["Title"] = "Historial Mensual";
}

<!-- Header -->
<header class="mb-section-margin">
    <h1 class="font-headline-xl text-headline-xl text-primary mb-2">Historial Mensual</h1>
    <p class="font-body-md text-body-md text-on-surface-variant">Revisa el resumen de tus finanzas mes a mes.</p>
</header>

@if (!Model.Months.Any())
{
    <!-- Estado vacío -->
    <section class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient border-2 border-dashed border-outline-variant text-center" aria-label="No hay historial disponible">
        <div class="w-16 h-16 mx-auto rounded-full bg-primary-container/10 flex items-center justify-center mb-4" aria-hidden="true">
            <span class="material-symbols-outlined text-primary" style="font-size: 32px;">history</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Sin historial aún</h2>
        <p class="mt-2 font-body-md text-body-md text-on-surface-variant max-w-md mx-auto">
            Cuando registres tu primer gasto o ingreso, aquí aparecerá un resumen mes a mes.
        </p>
        <div class="flex items-center justify-center gap-4 mt-6 flex-wrap">
            <a asp-controller="Expense" asp-action="Create"
               class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-6 py-3 rounded-full font-label-md text-label-md font-bold hover:opacity-90 transition-opacity">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                Registrar mi primer gasto
            </a>
            <a asp-controller="Income" asp-action="Create"
               class="inline-flex items-center gap-2 bg-transparent border-2 border-secondary text-secondary px-6 py-3 rounded-full font-label-md text-label-md hover:bg-secondary/5 transition-colors">
                <span class="material-symbols-outlined" style="font-size: 18px;">trending_up</span>
                Registrar ingreso
            </a>
        </div>
    </section>
}
else
{
    <!-- Bento Grid de meses -->
    <div id="monthsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-card-gap">
        @{ var index = 0; }
        @foreach (var month in Model.Months)
        {
            <article class="month-card bg-surface-container-lowest rounded-xl p-container-padding shadow-ambient transition-all duration-300 hover:shadow-[0_12px_40px_0_rgba(0,67,35,0.08)] hover:-translate-y-0.5 flex flex-col h-full border border-surface-container-high"
                     data-index="@index">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h2 class="font-headline-lg text-headline-lg text-primary capitalize">@month.MonthName</h2>
                        @if (month.IsCurrentMonth)
                        {
                            <span class="inline-block mt-1 bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded-full font-label-bold text-label-bold">Actual</span>
                        }
                    </div>
                    <span class="material-symbols-outlined @(month.IsCurrentMonth ? "text-secondary" : "text-outline")">
                        @(month.IsCurrentMonth ? "calendar_month" : "history")
                    </span>
                </div>

                <div class="flex-grow space-y-4 mb-8">
                    <div class="flex justify-between items-center pb-2 border-b border-surface-container">
                        <span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-[16px] text-primary">arrow_downward</span>
                            Ingresos
                        </span>
                        <span class="font-label-bold text-label-bold text-primary">+@Model.CurrencySymbol@month.TotalIncome.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center pb-2 border-b border-surface-container">
                        <span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-[16px] text-error">arrow_upward</span>
                            Gastos
                        </span>
                        <span class="font-label-bold text-label-bold text-error">-@Model.CurrencySymbol@month.TotalExpenses.ToString("N2")</span>
                    </div>
                </div>

                <a asp-action="Monthly" asp-route-year="@month.Year" asp-route-month="@month.Month"
                   class="w-full mt-auto flex justify-center items-center gap-2 @(month.IsCurrentMonth ? "bg-secondary-fixed text-on-secondary-fixed-variant hover:-translate-y-0.5" : "bg-surface-container-high text-primary hover:bg-surface-container") py-3 rounded-full font-label-bold text-label-bold transition-all group">
                    Ver resumen
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">
                        @(month.IsCurrentMonth ? "arrow_forward" : "chevron_right")
                    </span>
                </a>
            </article>
            index++;
        }
    </div>

    <!-- Paginación -->
    <nav id="pagination" class="mt-8 flex justify-center items-center gap-4" aria-label="Paginación del historial">
        <button id="prevPage" onclick="changePage(-1)"
                class="flex items-center justify-center w-10 h-10 rounded-full border border-outline-variant text-outline hover:bg-surface-container transition-colors"
                disabled>
            <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <div id="pageDots" class="flex gap-2"></div>
        <button id="nextPage" onclick="changePage(1)"
                class="flex items-center justify-center w-10 h-10 rounded-full border border-outline-variant text-outline hover:bg-surface-container transition-colors">
            <span class="material-symbols-outlined">chevron_right</span>
        </button>
    </nav>

    <script>
        (function () {
            const perPage = 3;
            const cards = document.querySelectorAll('.month-card');
            const totalPages = Math.ceil(cards.length / perPage);
            let currentPage = 0;

            function render() {
                cards.forEach(function (card, i) {
                    card.style.display = (i >= currentPage * perPage && i < (currentPage + 1) * perPage) ? '' : 'none';
                });

                var prev = document.getElementById('prevPage');
                var next = document.getElementById('nextPage');
                prev.disabled = currentPage === 0;
                next.disabled = currentPage >= totalPages - 1;

                prev.className = 'flex items-center justify-center w-10 h-10 rounded-full border transition-colors ' +
                    (currentPage === 0 ? 'border-outline-variant text-outline' : 'border-primary text-primary hover:bg-primary-container/10');
                next.className = 'flex items-center justify-center w-10 h-10 rounded-full border transition-colors ' +
                    (currentPage >= totalPages - 1 ? 'border-outline-variant text-outline' : 'border-primary text-primary hover:bg-primary-container/10');

                var dots = document.getElementById('pageDots');
                dots.innerHTML = '';
                for (var p = 0; p < totalPages; p++) {
                    var span = document.createElement('span');
                    span.className = 'w-2 h-2 rounded-full cursor-pointer transition-colors ' + (p === currentPage ? 'bg-primary' : 'bg-outline-variant');
                    span.setAttribute('data-page', p);
                    span.addEventListener('click', function () {
                        currentPage = parseInt(this.getAttribute('data-page'));
                        render();
                    });
                    dots.appendChild(span);
                }
            }

            window.changePage = function (delta) {
                currentPage = Math.max(0, Math.min(totalPages - 1, currentPage + delta));
                render();
            };

            render();
        })();
    </script>
}
