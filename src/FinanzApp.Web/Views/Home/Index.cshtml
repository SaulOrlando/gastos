@{
    ViewData["Title"] = "Toma el control de tus finanzas";
}

<div class="bg-[#f8faf9] text-gray-800 min-h-screen">

    <!-- HERO SECTION (Encabezado principal al estilo Obsidian) -->
    <section class="max-w-5xl mx-auto pt-20 pb-16 px-6 text-center">
        <!-- Badge superior -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-100/60 border border-emerald-200 text-[#064e3b] text-xs font-semibold mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Gestión financiera personal y simple
        </div>

        <!-- Título principal -->
        <h1 class="text-4xl sm:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
            Tus finanzas personales, <br class="hidden sm:inline" />
            <span class="text-[#064e3b]">bajo tu propio control.</span>
        </h1>

        <!-- Subtítulo motivacional -->
        <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-8 font-normal leading-relaxed">
            FinanzApp es el espacio donde registras, analizas y planificas cada dólar. Sin complicaciones, sin sorpresas a fin de mes.
        </p>

        <!-- Botones de Acción principal -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
            <a asp-controller="Auth" asp-action="Register"
               class="w-full sm:w-auto px-8 py-3.5 bg-[#064e3b] hover:bg-[#04382a] text-white font-bold text-base rounded-full shadow-lg shadow-emerald-900/10 transition-all transform hover:-translate-y-0.5">
                Comenzar Gratis
            </a>
            <a asp-controller="Auth" asp-action="Login"
               class="w-full sm:w-auto px-8 py-3.5 bg-white border border-gray-200 hover:border-gray-300 text-gray-700 font-semibold text-base rounded-full shadow-sm hover:bg-gray-50 transition-all">
                Iniciar Sesión
            </a>
        </div>

        <!-- Visualización previa / Maqueta -->
        <div class="relative mx-auto max-w-4xl rounded-2xl border border-gray-200 bg-white p-4 shadow-2xl shadow-emerald-950/5">
            <div class="flex items-center gap-2 pb-3 border-b border-gray-100 px-2 mb-4">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                <span class="text-xs text-gray-400 font-mono ml-2">finanzapp.internal/dashboard</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left p-2">
                <div class="p-4 rounded-xl bg-emerald-50/50 border border-emerald-100">
                    <p class="text-xs font-bold text-gray-400 uppercase">Ingresos del Mes</p>
                    <p class="text-2xl font-bold text-[#064e3b] mt-1">+$4,500.00</p>
                </div>
                <div class="p-4 rounded-xl bg-red-50/50 border border-red-100">
                    <p class="text-xs font-bold text-gray-400 uppercase">Gastos Totales</p>
                    <p class="text-2xl font-bold text-red-600 mt-1">-$1,240.50</p>
                </div>
                <div class="p-4 rounded-xl bg-gray-50 border border-gray-100">
                    <p class="text-xs font-bold text-gray-400 uppercase">Balance Disponible</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">$3,259.50</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN: ¿POR QUÉ ELEGIR FINANZAPP? (Ventajas clave) -->
    <section class="py-20 bg-white border-y border-gray-100">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-3xl font-bold text-[#064e3b] mb-4">¿Por qué utilizar FinanzApp?</h2>
                <p class="text-gray-600">Diseñado específicamente para ofrecerte claridad absoluta sobre tu dinero sin perder tiempo en configuraciones complejas.</p>
            </div>

            <!-- Grid de Características -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Tarjeta 1 -->
                <div class="p-8 rounded-2xl bg-[#f8faf9] border border-emerald-50 hover:border-emerald-200 transition-all hover:shadow-md">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xl mb-6">
                        <span class="material-symbols-outlined">bolt</span>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Registro al instante</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Añade tus gastos e ingresos diarios en menos de 5 segundos con selecciones rápidas de categorías personalizadas.
                    </p>
                </div>

                <!-- Tarjeta 2 -->
                <div class="p-8 rounded-2xl bg-[#f8faf9] border border-emerald-50 hover:border-emerald-200 transition-all hover:shadow-md">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xl mb-6">
                        <span class="material-symbols-outlined">pie_chart</span>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Control visual y claro</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Visualiza rápidamente en qué gastas tu dinero cada mes agrupado por alimentos, transporte, estudio y más.
                    </p>
                </div>

                <!-- Tarjeta 3 -->
                <div class="p-8 rounded-2xl bg-[#f8faf9] border border-emerald-50 hover:border-emerald-200 transition-all hover:shadow-md">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xl mb-6">
                        <span class="material-symbols-outlined">shield</span>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">100% Privado y Seguro</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Tus datos financieros te pertenecen únicamente a ti. Mantén tus registros protegidos bajo altos estándares de seguridad.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE VENTAJAS / LO QUE OFRECE EL SISTEMA -->
    <section class="py-20 max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl font-bold text-[#064e3b] mb-6">
                    Todo lo que necesitas para organizar tu patrimonio
                </h2>
                
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xs font-bold mt-1">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-800 text-sm">Configuración de sueldo regular</h4>
                            <p class="text-gray-500 text-xs mt-0.5">Ajusta si cobras quincenal, mensual o por días específicos.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xs font-bold mt-1">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-800 text-sm">Categorías a tu medida</h4>
                            <p class="text-gray-500 text-xs mt-0.5">Crea nuevas categorías dinámicamente con sus propios iconos.</p>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-emerald-100 text-[#064e3b] flex items-center justify-center text-xs font-bold mt-1">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-800 text-sm">Metas de Ahorro e Historial</h4>
                            <p class="text-gray-500 text-xs mt-0.5">Monitorea tus ahorros proyectados y revisa gastos pasados ordenados por mes.</p>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="bg-white p-8 rounded-3xl border border-gray-200 shadow-xl space-y-4">
                <div class="flex items-center justify-between p-4 rounded-xl bg-gray-50 border border-gray-100">
                    <span class="text-sm font-semibold text-gray-700">Comida & Cafetería</span>
                    <span class="text-sm font-bold text-red-500">-$45.00</span>
                </div>
                <div class="flex items-center justify-between p-4 rounded-xl bg-gray-50 border border-gray-100">
                    <span class="text-sm font-semibold text-gray-700">Transporte Publico</span>
                    <span class="text-sm font-bold text-red-500">-$15.00</span>
                </div>
                <div class="flex items-center justify-between p-4 rounded-xl bg-emerald-50 border border-emerald-100">
                    <span class="text-sm font-semibold text-[#064e3b]">Pago de Nómina / Quincena</span>
                    <span class="text-sm font-bold text-[#064e3b]">+$2,250.00</span>
                </div>
            </div>
        </div>
    </section>

    <!-- CALL TO ACTION FINAL -->
    <section class="bg-[#064e3b] text-white py-16 px-6 text-center">
        <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold mb-4">Empieza a controlar tus finanzas hoy mismo</h2>
            <p class="text-emerald-100 text-sm mb-8">Crea tu cuenta en segundos y da el primer paso hacia la libertad financiera.</p>
            <a asp-controller="Auth" asp-action="Register"
               class="inline-block px-8 py-3.5 bg-white text-[#064e3b] hover:bg-emerald-50 font-bold text-base rounded-full shadow-lg transition-all">
                Crear Mi Cuenta Gratis
            </a>
        </div>
    </section>

</div>