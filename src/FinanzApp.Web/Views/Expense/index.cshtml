@model IEnumerable<FinanzApp.Web.ViewModels.ExpenseListItemViewModel>

@{
    ViewData["Title"] = "Mis Gastos";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Encabezado y Buscador -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-emerald-950">Mis Gastos</h1>
            <p class="text-slate-500 text-sm">Revisa a dónde va tu dinero. ¡Mantén el control!</p>
        </div>
        <div class="relative w-full md:w-72">
            <input type="text" placeholder="Buscar gasto..." 
                   class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-full text-sm focus:outline-none focus:border-emerald-600 shadow-sm" />
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-lg">search</span>
        </div>
    </div>

    <!-- Tarjeta Resumen Total Gastado -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">Total gastado este mes</p>
            <h2 class="text-4xl font-extrabold text-slate-900 mt-1">
                €@Model.Sum(x => x.Amount).ToString("N2")
            </h2>
        </div>
        <div class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-semibold">
            <span class="material-symbols-outlined text-sm">calendar_today</span>
            <span>Mes actual</span>
        </div>
    </div>

    <!-- Filtros de Categorías -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 text-xs font-medium">
        <button class="px-4 py-2 bg-emerald-900 text-white rounded-full flex items-center gap-1 shadow-sm">
            <span class="material-symbols-outlined text-sm">check</span> Todast
        </button>
        <button class="px-4 py-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-full flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-sm">restaurant</span> Comida
        </button>
        <button class="px-4 py-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-full flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-sm">directions_bus</span> Transporte
        </button>
        <button class="px-4 py-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-full flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-sm">menu_book</span> Libros
        </button>
        <button class="px-4 py-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-full flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-sm">sports_esports</span> Ocio
        </button>
    </div>

    <!-- Lista de Transacciones -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 divide-y divide-slate-100 overflow-hidden">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center">
                            <span class="material-symbols-outlined text-xl">payments</span>
                        </div>
                        <div>
                            <h4 class="font-semibold text-slate-800 text-sm">@(string.IsNullOrWhiteSpace(item.Note) ? item.Category : item.Note)</h4>
                            <p class="text-xs text-slate-400">@item.Category • @item.Date.ToString("dd MMM, HH:mm")</p>
                        </div>
                    </div>
                    <div class="font-bold text-slate-800 text-sm">
                        -€@item.Amount.ToString("N2")
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No hay gastos registrados en este período.
            </div>
        }
    </div>
</div>