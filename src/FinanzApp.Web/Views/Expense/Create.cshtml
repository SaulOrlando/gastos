@model FinanzApp.Web.ViewModels.ExpenseFormViewModel
@{
    ViewData["Title"] = "Registrar Nuevo Gasto";

    var systemCats = Model.Categories.Where(c => c.IsSystem).ToList();
    var customCats = Model.Categories.Where(c => !c.IsSystem).ToList();
    var selectedCustom = customCats
        .FirstOrDefault(c => string.Equals(c.Name, Model.Category?.Trim(), StringComparison.OrdinalIgnoreCase));

    var selectedStyle = "border-[#064e3b] bg-emerald-50 text-[#064e3b]";
    var normalStyle = "border-gray-200 hover:border-[#064e3b] bg-white text-gray-700";
}

<div class="min-h-screen bg-[#e8f5e9] py-8 px-4 flex flex-col items-center">

    <!-- Encabezado -->
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-[#064e3b]">Registrar Nuevo Gasto</h1>
        <p class="text-gray-600 text-sm mt-1">Mantén el control de tus finanzas</p>
    </div>

    <!-- Tarjeta del Formulario -->
    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-sm p-8 mb-10 border border-emerald-50">
        <form asp-controller="Expense" asp-action="Create" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <!-- Campo Monto Centrado -->
            <div class="text-center">
                <label asp-for="Amount" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">MONTO</label>
                <div class="inline-flex items-center justify-center border-b-2 border-[#064e3b] pb-1 px-4">
                    <span class="text-3xl font-light text-[#064e3b] me-2">@Model.CurrencySymbol</span>
                    <input asp-for="Amount" type="number" step="0.01" placeholder="0.00"
                           class="w-48 text-3xl font-light text-gray-500 text-center focus:outline-none bg-transparent" />
                </div>
                <span asp-validation-for="Amount" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Selector de Categorías -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">CATEGORÍA</label>
                <input type="hidden" asp-for="Category" id="selectedCategory" />

                <div class="flex flex-wrap gap-2 content-start p-2.5 rounded-xl border border-gray-100 bg-white">
                    @foreach (var cat in systemCats)
                    {
                        if (string.Equals(cat.Name, "Otras", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="relative inline-block">
                                <button type="button" id="otrasChip"
                                        class="cat-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all text-sm @(selectedCustom is null ? normalStyle : selectedStyle)"
                                        onclick="toggleOtrasPopover(event)"
                                        aria-haspopup="true" aria-expanded="false">
                                    <span id="otrasChipLabel">@(selectedCustom?.Name is string selCustom ? "Otras · " + selCustom : "Otras")</span>
                                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </button>

                                <!-- Popover de categorías propias -->
                                <div id="otrasPopover"
                                     class="hidden absolute left-0 top-full mt-2 w-72 z-30 bg-white rounded-2xl shadow-lg border border-gray-100 p-3">
                                    <div class="mb-3 pb-3 border-b border-gray-100">
                                        <label for="newCategoryName" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">
                                            Crear categoría
                                        </label>
                                        <div class="flex items-center gap-2">
                                            <input type="text" id="newCategoryName" maxlength="50" placeholder="Ej. Mascotas, Ropa..."
                                                   class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:border-[#064e3b]" />
                                            <button type="button" onclick="saveNewCategory()"
                                                    class="shrink-0 px-3 py-2 rounded-full bg-[#064e3b] text-white text-xs font-bold hover:bg-[#04382a]">
                                                Crear
                                            </button>
                                        </div>
                                        <p id="newCategoryError" class="hidden text-xs text-red-500 mt-1" role="alert"></p>
                                    </div>

                                    <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Tus categorías</p>

                                    <div id="customCatList" class="space-y-1.5 max-h-56 overflow-y-auto">
                                        @foreach (var ucat in customCats)
                                        {
                                            <div class="cat-row flex items-center justify-between gap-2" data-cat-id="@ucat.Id" data-cat-name="@ucat.Name">
                                                <div class="min-w-0 flex-1">
                                                    <span class="cat-name block truncate text-sm font-medium text-gray-700">@ucat.Name</span>
                                                    <div class="cat-edit hidden items-center gap-1.5">
                                                        <input class="edit-name w-full min-w-0 rounded-lg border border-gray-200 px-2 py-1 text-sm focus:outline-none focus:border-[#064e3b]"
                                                               value="@ucat.Name" maxlength="50" />
                                                        <button type="button" class="shrink-0 text-xs font-bold text-[#064e3b] hover:underline"
                                                                onclick="saveEditCustomCat(this)">Guardar</button>
                                                        <button type="button" class="shrink-0 text-xs text-gray-400 hover:underline"
                                                                onclick="cancelEditCustomCat(this)">Cancelar</button>
                                                    </div>
                                                </div>
                                                <div class="cat-actions flex items-center gap-2 shrink-0">
                                                    <button type="button" class="text-xs font-semibold text-[#064e3b] hover:underline"
                                                            onclick="useCustomCat(this)">Usar</button>
                                                    <button type="button" class="text-xs font-semibold text-gray-500 hover:underline"
                                                            onclick="editCustomCat(this)">Editar</button>
                                                    <button type="button" class="text-xs font-semibold text-red-500 hover:underline"
                                                            onclick="deleteCustomCat(this)">Eliminar</button>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <p id="noCustomCats" class="text-xs text-gray-400 @(customCats.Count > 0 ? "hidden" : "")"
                                       role="status">
                                        Aún no has creado categorías propias. Crea una arribita.
                                    </p>
                                </div>
                            </div>
                        }
                        else
                        {
                            var isSelected = string.Equals(cat.Name, Model.Category?.Trim(), StringComparison.OrdinalIgnoreCase);
                            <button type="button" data-name="@cat.Name" onclick="selectCatFrom(this)"
                                    class="cat-btn inline-flex items-center px-3 py-2 rounded-full border transition-all text-sm @(isSelected ? selectedStyle : normalStyle)">
                                @cat.Name
                            </button>
                        }
                    }
                </div>
                <span asp-validation-for="Category" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Inputs Fecha y Nota -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div>
                    <label asp-for="Date" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">FECHA</label>
                    <input asp-for="Date" type="date"
                           class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-600 focus:outline-none focus:border-[#064e3b]" />
                    <span asp-validation-for="Date" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Note" class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1">NOTA (OPCIONAL)</label>
                    <input asp-for="Note" placeholder="Ej. Almuerzo"
                           class="w-full rounded-xl border border-gray-200 p-3 text-sm text-gray-600 focus:outline-none focus:border-[#064e3b]" />
                    <span asp-validation-for="Note" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Botón Principal -->
            <div class="pt-4">
                <button type="submit"
                        class="w-full py-3.5 bg-[#064e3b] hover:bg-[#04382a] text-white font-bold text-base rounded-full shadow-md transition-all">
                    Guardar Gasto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const popover = document.getElementById('otrasPopover');
        const chip = document.getElementById('otrasChip');
        const chipLabel = document.getElementById('otrasChipLabel');
        const selectedInput = document.getElementById('selectedCategory');
        const selectedStyle = ['border-[#064e3b]', 'bg-emerald-50', 'text-[#064e3b]'];
        const normalStyle = ['border-gray-200', 'bg-white', 'text-gray-700'];

        function applyStyle(el, style) {
            el.classList.remove(...selectedStyle, ...normalStyle);
            el.classList.add(...style);
        }

        function markCustomSelected(name, label) {
            selectedInput.value = name;
            applyStyle(chip, selectedStyle);
            chipLabel.textContent = 'Otras · ' + label;
        }

        function clearOtrasVisual() {
            applyStyle(chip, normalStyle);
            chipLabel.textContent = 'Otras';
        }

        function clearCustomSelection() {
            selectedInput.value = '';
            clearOtrasVisual();
        }

        function selectCatFrom(btn) {
            const name = btn.dataset.name;
            selectedInput.value = name;

            document.querySelectorAll('.cat-btn').forEach(b => {
                if (b.classList.contains('border-[#064e3b]')) applyStyle(b, normalStyle);
            });

            applyStyle(btn, selectedStyle);
            clearOtrasVisual();
        }

        function toggleOtrasPopover(event) {
            event.stopPropagation();
            const opening = popover.classList.contains('hidden');
            popover.classList.toggle('hidden');
            chip.setAttribute('aria-expanded', opening ? 'true' : 'false');
        }

        function closeOtrasPopover() {
            popover.classList.add('hidden');
            chip.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', function (event) {
            if (!popover.parentElement.contains(event.target)) {
                closeOtrasPopover();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeOtrasPopover();
                const editing = document.querySelector('.cat-edit:not(.hidden)');
                if (editing) cancelEditCustomCat(editing.querySelector('.shrink-0'));
            }
        });

        function useCustomCat(btn) {
            const row = btn.closest('.cat-row');
            markCustomSelected(row.dataset.catName, row.dataset.catName);
            closeOtrasPopover();
        }

        function editCustomCat(btn) {
            const row = btn.closest('.cat-row');
            row.querySelector('.cat-name').classList.add('hidden');
            row.querySelector('.cat-actions').classList.add('hidden');
            const editRow = row.querySelector('.cat-edit');
            editRow.classList.remove('hidden');
            editRow.classList.add('flex');
            editRow.querySelector('.edit-name').focus();
        }

        function cancelEditCustomCat(btn) {
            const row = btn.closest('.cat-row');
            row.querySelector('.cat-name').classList.remove('hidden');
            row.querySelector('.cat-actions').classList.remove('hidden');
            const editRow = row.querySelector('.cat-edit');
            editRow.classList.add('hidden');
            editRow.classList.remove('flex');
        }

        async function saveEditCustomCat(btn) {
            const row = btn.closest('.cat-row');
            const input = row.querySelector('.edit-name');
            const newName = input.value.trim();
            const oldName = row.dataset.catName;
            const errorTarget = document.getElementById('newCategoryError');

            if (!newName) {
                errorTarget.textContent = 'Escribe un nombre para la categoría.';
                errorTarget.classList.remove('hidden');
                return;
            }

            const form = new FormData();
            form.append('id', row.dataset.catId);
            form.append('name', newName);
            form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const res = await fetch('/Expense/UpdateCategory', { method: 'POST', body: form });
                const data = await res.json();
                if (!data.success) {
                    errorTarget.textContent = data.message || 'No se pudo guardar. Intenta de nuevo.';
                    errorTarget.classList.remove('hidden');
                    return;
                }

                row.dataset.catName = data.name;
                row.querySelector('.cat-name').textContent = data.name;
                input.value = data.name;

                if (selectedInput.value.toLowerCase() === oldName.toLowerCase()) {
                    markCustomSelected(data.name, data.name);
                }

                errorTarget.classList.add('hidden');
                cancelEditCustomCat(btn);
            } catch (e) {
                errorTarget.textContent = 'No se pudo conectar. Revisa tu conexión e intenta de nuevo.';
                errorTarget.classList.remove('hidden');
            }
        }

        async function deleteCustomCat(btn) {
            const row = btn.closest('.cat-row');
            const isSelected = selectedInput.value.toLowerCase() === row.dataset.catName.toLowerCase();

            const form = new FormData();
            form.append('id', row.dataset.catId);
            form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const res = await fetch('/Expense/DeleteCategory', { method: 'POST', body: form });
                const data = await res.json();
                if (!data.success) {
                    alert(data.message || 'No se pudo eliminar. Intenta de nuevo.');
                    return;
                }

                row.remove();
                if (isSelected) {
                    clearCustomSelection();
                }
                if (!document.querySelector('#customCatList .cat-row')) {
                    document.getElementById('noCustomCats').classList.remove('hidden');
                }
            } catch (e) {
                alert('No se pudo conectar. Revisa tu conexión e intenta de nuevo.');
            }
        }

        function buildCatRow(id, name) {
            const row = document.createElement('div');
            row.className = 'cat-row flex items-center justify-between gap-2';
            row.dataset.catId = id;
            row.dataset.catName = name;
            row.innerHTML =
                '<div class="min-w-0 flex-1">' +
                    '<span class="cat-name block truncate text-sm font-medium text-gray-700"></span>' +
                    '<div class="cat-edit hidden items-center gap-1.5">' +
                        '<input class="edit-name w-full min-w-0 rounded-lg border border-gray-200 px-2 py-1 text-sm focus:outline-none focus:border-[#064e3b]" maxlength="50" />' +
                        '<button type="button" class="shrink-0 text-xs font-bold text-[#064e3b] hover:underline">Guardar</button>' +
                        '<button type="button" class="shrink-0 text-xs text-gray-400 hover:underline">Cancelar</button>' +
                    '</div>' +
                '</div>' +
                '<div class="cat-actions flex items-center gap-2 shrink-0">' +
                    '<button type="button" class="text-xs font-semibold text-[#064e3b] hover:underline">Usar</button>' +
                    '<button type="button" class="text-xs font-semibold text-gray-500 hover:underline">Editar</button>' +
                    '<button type="button" class="text-xs font-semibold text-red-500 hover:underline">Eliminar</button>' +
                '</div>';
            row.querySelector('.cat-name').textContent = name;
            row.querySelector('.edit-name').value = name;
            row.querySelector('.cat-actions button:nth-child(1)').onclick = function () { useCustomCat(this); };
            row.querySelector('.cat-actions button:nth-child(2)').onclick = function () { editCustomCat(this); };
            row.querySelector('.cat-actions button:nth-child(3)').onclick = function () { deleteCustomCat(this); };
            return row;
        }

        async function saveNewCategory() {
            const input = document.getElementById('newCategoryName');
            const name = input.value.trim();
            const errorEl = document.getElementById('newCategoryError');

            if (!name) {
                errorEl.textContent = 'Escribe un nombre para la categoría.';
                errorEl.classList.remove('hidden');
                return;
            }

            const form = new FormData();
            form.append('name', name);
            form.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const res = await fetch('/Expense/CreateCategory', { method: 'POST', body: form });
                const data = await res.json();
                if (!data.success) {
                    errorEl.textContent = data.message || 'No se pudo guardar. Intenta de nuevo.';
                    errorEl.classList.remove('hidden');
                    return;
                }

                document.getElementById('noCustomCats').classList.add('hidden');
                document.getElementById('customCatList').appendChild(buildCatRow(data.id, data.name));
                input.value = '';
                errorEl.classList.add('hidden');
                markCustomSelected(data.name, data.name);
                closeOtrasPopover();
            } catch (e) {
                errorEl.textContent = 'No se pudo conectar. Revisa tu conexión e intenta de nuevo.';
                errorEl.classList.remove('hidden');
            }
        }
    </script>
}