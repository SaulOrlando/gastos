@model FinanzApp.Web.ViewModels.ExpenseFormViewModel
@{
    ViewData["Title"] = "Registrar Gasto";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Registrar gasto
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Anótalo en segundos y mantén tus finanzas claras.
    </p>

    <form asp-action="Create" method="post"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario para registrar un gasto">
        <partial name="_ExpenseFormFields" model="Model" />

        <button type="submit"
                class="w-full bg-accent hover:bg-accent-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-accent-light/40">
            Guardar gasto
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-secondary">
        <a asp-action="Index" class="font-bold text-accent hover:text-accent-dark focus:outline-none focus:underline">
            Ver todos mis gastos
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
