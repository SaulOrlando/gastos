@model FinanzApp.Web.ViewModels.ExpenseFormViewModel
@{
    ViewData["Title"] = "Editar Gasto";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Editar gasto
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Cambia lo que necesites y guarda los ajustes.
    </p>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario para editar un gasto">
        <input type="hidden" asp-for="Id" />
        <partial name="_ExpenseFormFields" model="Model" />

        <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">
            <a asp-action="Index"
               class="text-center border-2 border-slate-200 hover:border-secondary transition-colors text-secondary font-bold px-6 py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-slate-200">
                Cancelar
            </a>
            <button type="submit"
                    class="flex-1 bg-accent hover:bg-accent-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-accent-light/40">
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
