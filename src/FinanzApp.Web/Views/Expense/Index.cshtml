@model FinanzApp.Web.ViewModels.ExpenseListViewModel
@{
    ViewData["Title"] = "Mis Gastos";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark">Mis gastos</h1>
            <p class="text-secondary text-sm mt-1">
                @Model.Items.Count gasto(s) registrado(s) · Total: @Model.CurrencySymbol@Model.TotalAmount.ToString("N2")
            </p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark transition-colors text-white font-bold text-lg px-8 py-4 rounded-full shadow-md focus:outline-none focus:ring-4 focus:ring-accent-light/40"
           aria-label="Registrar un gasto nuevo">
            + Registrar gasto
        </a>
    </div>

    @if (!Model.Items.Any())
    {
        <section class="bg-white rounded-2xl shadow-sm border-2 border-dashed border-slate-200 p-10 text-center" aria-label="Aún no hay gastos">
            <h2 class="text-xl font-bold text-secondary-dark">Tu historial está vacío</h2>
            <p class="mt-2 text-secondary max-w-md mx-auto">
                Anota tu primer gasto y empieza a ver en claro a dónde se va tu dinero.
                Ese botón grande de arriba es el comienzo.
            </p>
        </section>
    }
    else
    {
        <!-- Tabla para pantallas medianas+ -->
        <section class="hidden sm:block bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden" aria-label="Historial de gastos">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-primary text-white text-xs uppercase tracking-wider">
                        <th scope="col" class="px-6 py-4">Categoría</th>
                        <th scope="col" class="px-6 py-4">Fecha</th>
                        <th scope="col" class="px-6 py-4">Nota</th>
                        <th scope="col" class="px-6 py-4 text-right">Monto</th>
                        <th scope="col" class="px-6 py-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <span class="@GetCategoryBadgeClass(item.Category) text-white text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap">
                                    @item.Category
                                </span>
                            </td>
                            <td class="px-6 py-4 text-secondary whitespace-nowrap">@item.Date.ToString("dd MMM yyyy")</td>
                            <td class="px-6 py-4 text-secondary-light max-w-[200px] truncate" title="@item.Note">@(item.Note ?? "—")</td>
                            <td class="px-6 py-4 font-bold text-secondary-dark text-right whitespace-nowrap">
                                @Model.CurrencySymbol@item.Amount.ToString("N2")
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="font-semibold text-accent hover:text-accent-dark focus:outline-none focus:underline mr-4"
                                   aria-label="Editar gasto de @item.Date.ToString("dd MMM") por @item.Amount">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="font-semibold text-red-500 hover:text-red-700 focus:outline-none focus:underline"
                                   aria-label="Eliminar gasto de @item.Date.ToString("dd MMM") por @item.Amount">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- Tarjetas para móvil -->
        <section class="sm:hidden space-y-3" aria-label="Historial de gastos">
            @foreach (var item in Model.Items)
            {
                <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <span class="@GetCategoryBadgeClass(item.Category) text-white text-xs font-bold px-3 py-1.5 rounded-full">
                                @item.Category
                            </span>
                            <p class="mt-2 text-sm text-secondary-light truncate">@item.Date.ToString("dd MMM yyyy") · @(item.Note ?? "Sin nota")</p>
                        </div>
                        <p class="font-extrabold text-lg text-secondary-dark whitespace-nowrap">
                            @Model.CurrencySymbol@item.Amount.ToString("N2")
                        </p>
                    </div>
                    <div class="flex gap-4 mt-3 pt-3 border-t border-slate-100">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="font-semibold text-accent text-sm focus:outline-none focus:underline">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="font-semibold text-red-500 text-sm focus:outline-none focus:underline">Eliminar</a>
                    </div>
                </article>
            }
        </section>
    }
</div>

@functions {
    private static string GetCategoryBadgeClass(ExpenseCategory category) => category switch
    {
        ExpenseCategory.Mensualidad => "bg-primary",
        ExpenseCategory.Transporte => "bg-accent",
        ExpenseCategory.Comida => "bg-secondary",
        _ => "bg-amber-500"
    };
}
