<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinanzApp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#14532d',
                            dark: '#052e16',
                            light: '#166534'
                        },
                        secondary: {
                            DEFAULT: '#475569',
                            light: '#64748b',
                            dark: '#334155'
                        },
                        accent: {
                            DEFAULT: '#7c3aed',
                            light: '#8b5cf6',
                            dark: '#6d28d9'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans text-secondary-dark">
    <header>
        <nav class="bg-primary shadow-md">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="text-white text-xl font-bold tracking-tight hover:text-accent-light transition-colors">
                    FinanzApp
                </a>
                <ul class="flex items-center gap-4 sm:gap-6">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="hidden sm:block text-emerald-100 text-sm">
                            Hola, @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Dashboard" asp-action="Index"
                               class="text-white hover:text-accent-light transition-colors font-medium">Dashboard</a>
                        </li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit"
                                        class="text-white hover:text-accent-light transition-colors font-medium focus:outline-none focus:underline cursor-pointer"
                                        aria-label="Cerrar sesión">
                                    Salir
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-area="" asp-controller="Auth" asp-action="Login"
                               class="text-emerald-100 hover:text-accent-light transition-colors font-medium">Iniciar sesión</a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Auth" asp-action="Register"
                               class="bg-accent hover:bg-accent-dark transition-colors text-white font-bold px-4 py-2 rounded-full focus:outline-none focus:ring-2 focus:ring-accent-light">Registrarse</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-1 w-full max-w-6xl mx-auto px-4 py-6 sm:py-10">
        @RenderBody()
    </main>

    <footer class="bg-secondary-dark text-slate-300">
        <div class="max-w-6xl mx-auto px-4 py-4 text-sm flex flex-col sm:flex-row items-center justify-between gap-2">
            <span>&copy; 2026 - FinanzApp · Tus finanzas, sin complicaciones</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-accent-light transition-colors">Privacidad</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
