<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinanzApp</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary:        { DEFAULT: '#004323', container: '#0b5d34', dark: '#00210e', light: '#00522c' },
                        'on-primary':   '#ffffff',
                        secondary:      { DEFAULT: '#006d3d', container: '#67faa4', dark: '#00522c', light: '#48e08c' },
                        'on-secondary': '#ffffff',
                        accent:         { DEFAULT: '#006d3d', dark: '#00522c', light: '#48e08c' },
                        surface:        { DEFAULT: '#f1fcf7', dim: '#d1ddd8', bright: '#f1fcf7',
                                          container: { DEFAULT: '#e5f0eb', low: '#ebf6f1', high: '#dfebe6',
                                                       highest: '#dae5e0', lowest: '#ffffff' } },
                        'on-surface':   { DEFAULT: '#141e1b', variant: '#404941' },
                        'on-background':'#141e1b',
                        outline:        { DEFAULT: '#707a70', variant: '#bfc9be' },
                        tertiary:       { DEFAULT: '#353b3a', container: '#4c5251' },
                        error:          { DEFAULT: '#ba1a1a', container: '#ffdad6' },
                    },
                    borderRadius: {
                        DEFAULT: '0.25rem',
                        lg: '0.5rem',
                        xl: '0.75rem',
                        full: '9999px'
                    },
                    spacing: {
                        gutter: '16px',
                        'section-margin': '40px',
                        'container-padding': '24px',
                        'base-unit': '8px',
                        'card-gap': '16px'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                        'headline-xl': ['Manrope', 'system-ui', 'sans-serif'],
                        'headline-lg': ['Manrope', 'system-ui', 'sans-serif'],
                        'body-md': ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                        'body-sm': ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                        'label-bold': ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                        'label-md': ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
                    },
                    fontSize: {
                        'headline-xl': ['32px', { lineHeight: '40px', fontWeight: '700' }],
                        'headline-lg': ['24px', { lineHeight: '32px', fontWeight: '600' }],
                        'headline-lg-mobile': ['20px', { lineHeight: '28px', fontWeight: '600' }],
                        'body-md': ['16px', { lineHeight: '24px', fontWeight: '400' }],
                        'body-sm': ['14px', { lineHeight: '20px', fontWeight: '400' }],
                        'label-bold': ['12px', { lineHeight: '16px', letterSpacing: '0.05em', fontWeight: '700' }],
                        'label-md': ['12px', { lineHeight: '16px', fontWeight: '500' }],
                    },
                    boxShadow: {
                        'ambient': '0 4px 20px 0 rgba(0, 67, 35, 0.04)',
                        'ambient-hover': '0 12px 40px 0 rgba(0, 67, 35, 0.08)',
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .icon-filled {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-surface min-h-screen flex flex-col font-body-md text-on-surface antialiased">
    @await Component.InvokeAsync("TopNav")

    <main role="main" class="flex-1 w-full max-w-7xl mx-auto px-gutter md:px-section-margin py-8 md:py-12 flex flex-col gap-8">
        @RenderBody()
    </main>

    <footer class="bg-surface border-t border-outline-variant mt-12">
        <div class="w-full max-w-7xl mx-auto py-8 px-gutter flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="font-headline-lg text-headline-lg text-primary">FinanzApp</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant">&copy; 2026 FinanzApp Estudiantil</div>
            <div class="flex items-center gap-6">
                <a asp-area="" asp-controller="Home" asp-action="Privacy"
                   class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors">Privacidad</a>
                <a href="#"
                   class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors">Términos</a>
                <a href="#"
                   class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors">Contacto</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
