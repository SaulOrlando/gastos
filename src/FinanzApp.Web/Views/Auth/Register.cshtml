@model FinanzApp.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Crea tu cuenta gratis
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Un minuto de registro, un semestre entero de finanzas claras.
    </p>

    <form asp-action="Register" method="post"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario de registro">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 border border-red-200 rounded-lg p-3" role="alert"></div>

        <div>
            <label asp-for="FullName" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="FullName"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="¿Cómo te llamas?" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Email"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="tu@correo.com" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Password"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="ConfirmPassword"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="Repite tu contraseña" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Currency" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <select asp-for="Currency"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    aria-describedby="CurrencyHelp">
                <option value="USD">USD — Dólar estadounidense</option>
                <option value="EUR">EUR — Euro</option>
                <option value="MXN">MXN — Peso mexicano</option>
                <option value="COP">COP — Peso colombiano</option>
            </select>
            <span asp-validation-for="Currency" class="text-red-500 text-sm mt-1 block"></span>
            <p id="CurrencyHelp" class="text-xs text-secondary-light mt-1">
                Elige la moneda en la que manejas tu dinero. No podrás cambiarla después.
            </p>
        </div>

        <button type="submit"
                class="w-full bg-accent hover:bg-accent-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-accent-light/40">
            Crear mi cuenta
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-secondary">
        ¿Ya tienes cuenta?
        <a asp-action="Login" asp-controller="Auth" class="font-bold text-accent hover:text-accent-dark focus:outline-none focus:underline">
            Inicia sesión
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
