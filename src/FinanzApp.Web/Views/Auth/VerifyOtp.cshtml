@model FinanzApp.Web.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Verifica tu código";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Verifica tu identidad
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Te enviamos un código de 6 dígitos a <span class="font-semibold text-secondary-dark">@Model.Email</span>.
    </p>

    @if (TempData["OtpSendError"] is true)
    {
        <div class="mt-6 bg-error-container/30 border border-error/20 text-error rounded-xl px-4 py-3 text-sm text-center" role="alert">
            <p class="font-semibold">No pudimos enviar el código por correo.</p>
            <p class="mt-1 text-xs">Revisa la configuración SMTP en la consola. Este aviso solo aparece en desarrollo.</p>
        </div>
    }

    <form asp-action="VerifyOtp" method="post"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario de verificación de código">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 border border-red-200 rounded-lg p-3" role="alert"></div>

        <input asp-for="Email" type="hidden" />

        <div>
            <label asp-for="Code" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Code"
                   class="w-full rounded-xl border border-slate-300 px-4 py-4 text-center text-3xl font-bold tracking-[0.5em] text-secondary-dark placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
            <span asp-validation-for="Code" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <button type="submit"
                class="w-full bg-primary hover:bg-primary-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-primary-light/40">
            Verificar código
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-secondary">
        ¿No recibiste el código?
        <a asp-action="ForgotPassword" asp-controller="Auth" class="font-bold text-accent hover:text-accent-dark focus:outline-none focus:underline">
            Enviar de nuevo
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
