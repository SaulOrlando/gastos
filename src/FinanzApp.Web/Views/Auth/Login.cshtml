@model FinanzApp.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Bienvenido de vuelta
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Tus finanzas te esperan. Entra y sigue avanzando.
    </p>

    <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario de inicio de sesión">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 border border-red-200 rounded-lg p-3" role="alert"></div>

        <div>
            <label asp-for="Email" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Email"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="tu@correo.com" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Password"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                   placeholder="Tu contraseña" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div class="flex items-center gap-2">
            <input asp-for="RememberMe"
                   class="h-4 w-4 rounded border-slate-300 text-accent focus:ring-accent" />
            <label asp-for="RememberMe" class="text-sm text-secondary select-none"></label>
        </div>

        <button type="submit"
                class="w-full bg-primary hover:bg-primary-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-primary-light/40">
            Entrar
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-secondary">
        ¿Aún no tienes cuenta?
        <a asp-action="Register" asp-controller="Auth" class="font-bold text-accent hover:text-accent-dark focus:outline-none focus:underline">
            Regístrate gratis
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
