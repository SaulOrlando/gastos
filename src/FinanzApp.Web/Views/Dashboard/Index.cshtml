@model FinanzApp.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Mi Dashboard";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark">Tu resumen de @Model.MonthName</h1>
    </div>

    @if (TempData["BudgetSaved"] is true)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-primary-dark rounded-xl px-4 py-3 text-sm" role="status">
            Presupuesto guardado. Así se hace.
        </div>
    }
    @if (TempData["BudgetError"] is string budgetError)
    {
        <div class="bg-red-50 border border-red-200 text-red-600 rounded-xl px-4 py-3 text-sm" role="alert">
            @budgetError
        </div>
    }

    <!-- Tarjetas superiores -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6" aria-label="Resumen financiero del mes">
        <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <h2 class="text-sm font-semibold text-secondary uppercase tracking-wide">Total gastado</h2>
            <p class="mt-2 text-3xl font-extrabold text-secondary-dark">
                @Model.CurrencySymbol@Model.TotalSpent.ToString("N2")
            </p>
            <p class="mt-1 text-xs text-secondary-light">En lo que va de @Model.MonthName</p>
        </article>

        <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <h2 class="text-sm font-semibold text-secondary uppercase tracking-wide">Presupuesto restante</h2>
            @if (Model.HasBudget)
            {
                var overBudget = Model.RemainingBudget < 0;
                <p class="mt-2 text-3xl font-extrabold @(overBudget ? "text-red-500" : "text-primary")">
                    @Model.CurrencySymbol@Model.RemainingBudget.ToString("N2")
                </p>
                <p class="mt-1 text-xs @(overBudget ? "text-red-400" : "text-secondary-light")">
                    @(overBudget ? "Te pasaste del presupuesto, ojo." : $"De {@Model.CurrencySymbol}{Model.MonthlyBudget?.ToString("N2")}")
                </p>
            }
            else
            {
                <p class="mt-2 text-lg font-bold text-secondary-light">Sin presupuesto aún</p>
            }
        </article>

        <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <h2 class="text-sm font-semibold text-secondary uppercase tracking-wide">Tu presupuesto mensual</h2>
            <form asp-action="SetBudget" method="post" class="mt-3 flex gap-2" aria-label="Establecer presupuesto mensual">
                <input type="number" name="amount" min="0" step="0.01"
                       value="@Model.MonthlyBudget?.ToString("0.##")"
                       placeholder="Ej. 3500"
                       required
                       aria-label="Monto del presupuesto mensual"
                       class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-secondary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent" />
                <button type="submit"
                        class="shrink-0 bg-accent hover:bg-accent-dark transition-colors text-white font-bold px-4 py-2.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-accent-light/40">
                    Guardar
                </button>
            </form>
            <p class="mt-2 text-xs text-secondary-light">¿Cuánto puedes gastar este mes sin sufrir?</p>
        </article>
    </section>

    @if (Model.HasExpenses)
    {
        <!-- Gráficos -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6" aria-label="Gráficos de gastos">
            <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <h2 class="font-bold text-lg text-secondary-dark">Distribución de gastos</h2>
                <p class="text-xs text-secondary-light mb-4">Por categoría en @Model.MonthName</p>
                <div class="relative h-64 sm:h-72">
                    <canvas id="donutChart" role="img"
                            aria-label="Gráfico de dona con tu distribución de gastos por categoría"></canvas>
                </div>
                <p class="sr-only">
                    Total gastado este mes: @Model.CurrencySymbol@Model.TotalSpent.ToString("N2").
                    Consulta la lista de gastos para ver el detalle por categoría.
                </p>
            </article>

            <article class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                <h2 class="font-bold text-lg text-secondary-dark">Tendencia de 30 días</h2>
                <p class="text-xs text-secondary-light mb-4">Gasto por día</p>
                <div class="relative h-64 sm:h-72">
                    <canvas id="lineChart" role="img"
                            aria-label="Gráfico de línea con tu gasto diario de los últimos 30 días"></canvas>
                </div>
                <p class="sr-only">Gastos diarios de los últimos 30 días.</p>
            </article>
        </section>
    }
    else
    {
        <!-- Estado vacío -->
        <section class="bg-white rounded-2xl shadow-sm border-2 border-dashed border-slate-200 p-10 text-center" aria-label="Aún no hay gastos registrados">
            <div class="w-16 h-16 mx-auto rounded-full bg-accent/10 flex items-center justify-center mb-4" aria-hidden="true">
                <span class="text-accent text-3xl font-bold">$</span>
            </div>
            <h2 class="text-xl font-bold text-secondary-dark">Aquí no hay nada... ¡todavía!</h2>
            <p class="mt-2 text-secondary max-w-md mx-auto">
                Cuando registres tu primer gasto, esta sección cobrará vida con gráficas
                de a dónde va tu dinero. Empieza anotando ese café de hoy.
            </p>
        </section>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            const catLabels = @Html.Raw(Model.LabelsCategoriaJson);
            const catValues = @Html.Raw(Model.ValoresCategoriaJson);
            const catColors = @Html.Raw(Model.ColoresCategoriaJson);
            const dayLabels = @Html.Raw(Model.LabelsDiasJson);
            const dayValues = @Html.Raw(Model.ValoresDiasJson);

            Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
            Chart.defaults.color = '#475569';

            const donutCanvas = document.getElementById('donutChart');
            if (donutCanvas) {
                new Chart(donutCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catValues,
                            backgroundColor: catColors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ' ' + ctx.label + ': ' + ctx.parsed.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const lineCanvas = document.getElementById('lineChart');
            if (lineCanvas) {
                new Chart(lineCanvas, {
                    type: 'line',
                    data: {
                        labels: dayLabels,
                        datasets: [{
                            label: 'Gasto del día',
                            data: dayValues,
                            borderColor: '#7c3aed',
                            backgroundColor: 'rgba(124, 58, 237, 0.08)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            }
        })();
    </script>
}
