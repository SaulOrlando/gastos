@model FinanzApp.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel Principal";
}

<!-- Header -->
<header class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
    <div>
        <h1 class="font-headline-xl text-headline-xl text-on-surface">Resumen de @Model.MonthName</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">Mantén el control, vas por buen camino.</p>
    </div>
    <div class="flex items-center gap-4 mt-4 flex-wrap">
        <a asp-controller="History" asp-action="Index"
           class="flex items-center gap-2 bg-surface-container-highest text-on-surface-variant px-6 py-2 rounded-full font-label-md text-label-md hover:bg-surface-variant transition-colors">
            <span class="material-symbols-outlined" style="font-size: 18px;">history</span>
            Historial
        </a>
        <a asp-controller="Expense" asp-action="Create" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
           class="flex items-center gap-2 bg-secondary-container text-on-secondary-container px-6 py-2 rounded-full font-label-md text-label-md font-bold hover:opacity-90 transition-opacity">
            <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
            Registrar Gasto
        </a>
        <a asp-controller="Income" asp-action="Create" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
           class="flex items-center gap-2 bg-transparent border-2 border-secondary text-secondary px-6 py-2 rounded-full font-label-md text-label-md hover:bg-secondary/5 transition-colors">
            <span class="material-symbols-outlined" style="font-size: 18px;">trending_up</span>
            Registrar Ingreso
        </a>
    </div>
</header>

@if (TempData["BudgetSaved"] is true)
{
    <div class="bg-secondary-container/30 border border-secondary/20 text-on-surface rounded-[16px] px-4 py-3 font-body-sm text-body-sm flex items-center gap-2" role="status">
        <span class="material-symbols-outlined text-secondary" style="font-size: 18px;">check_circle</span>
        Presupuesto guardado. Así se hace.
    </div>
}
@if (TempData["BudgetError"] is string budgetError)
{
    <div class="bg-error-container/30 border border-error/20 text-error rounded-[16px] px-4 py-3 font-body-sm text-body-sm flex items-center gap-2" role="alert">
        <span class="material-symbols-outlined text-error" style="font-size: 18px;">error</span>
        @budgetError
    </div>
}

<!-- Top Metrics Cards -->
<section class="grid grid-cols-1 md:grid-cols-4 gap-card-gap" aria-label="Resumen financiero del mes">
    <!-- Card 1: Ingreso Total -->
    <article class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient transition-all duration-300 hover:shadow-[0_12px_40px_0_rgba(0,67,35,0.08)] hover:-translate-y-0.5 flex flex-col justify-between h-[160px]">
        <div class="flex justify-between items-start">
            <div class="flex items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined icon-filled text-primary">account_balance</span>
                <h3 class="font-label-bold text-label-bold uppercase">Ingreso total del mes</h3>
            </div>
            <span class="material-symbols-outlined text-outline-variant" style="font-size: 40px; opacity: 0.3;">attach_money</span>
        </div>
        <div class="font-headline-xl text-headline-xl text-primary mt-auto">
            @Model.CurrencySymbol@Model.TotalIncome.ToString("N2")
        </div>
    </article>

    <!-- Card 2: Gasto Total -->
    <article class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient transition-all duration-300 hover:shadow-[0_12px_40px_0_rgba(0,67,35,0.08)] hover:-translate-y-0.5 flex flex-col justify-between h-[160px]">
        <div class="flex justify-between items-start">
            <div class="flex items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined icon-filled text-error">account_balance_wallet</span>
                <h3 class="font-label-bold text-label-bold uppercase">Gasto total del mes</h3>
            </div>
            <span class="material-symbols-outlined text-outline-variant" style="font-size: 40px; opacity: 0.3;">payments</span>
        </div>
        <div class="font-headline-xl text-headline-xl text-error mt-auto">
            @Model.CurrencySymbol@Model.TotalSpent.ToString("N2")
        </div>
    </article>

    <!-- Card 3: Presupuesto Restante -->
    <article class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient transition-all duration-300 hover:shadow-[0_12px_40px_0_rgba(0,67,35,0.08)] hover:-translate-y-0.5 flex flex-col justify-between h-[160px]">
        <div class="flex justify-between items-start">
            <div class="flex items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined icon-filled text-outline">savings</span>
                <h3 class="font-label-bold text-label-bold uppercase">Disponible</h3>
            </div>
            <span class="material-symbols-outlined text-outline-variant" style="font-size: 40px; opacity: 0.3;">stream_apps</span>
        </div>
        <div class="flex flex-col gap-3 mt-auto">
            @{
                var isNegative = Model.RemainingBudget < 0;
            }
            <div class="font-headline-lg text-headline-lg @(isNegative ? "text-error" : "text-secondary")">
                @Model.CurrencySymbol@Model.RemainingBudget.ToString("N2")
            </div>
            <div class="w-full h-2 bg-surface-variant rounded-full overflow-hidden">
                <div class="h-full @(isNegative ? "bg-error" : "bg-secondary") rounded-full transition-all duration-500"
                     style="width: @(isNegative ? "100" : Math.Min(100, Math.Max(0, (int)(Model.TotalIncomeCumulative > 0 ? Model.RemainingBudget / Model.TotalIncomeCumulative * 100 : 0))))%;"></div>
            </div>
        </div>
    </article>

    <!-- Card 4: Meta de Ahorro (placeholder) -->
    <article class="bg-surface-container-low rounded-[16px] p-container-padding shadow-ambient transition-all duration-300 hover:shadow-[0_12px_40px_0_rgba(0,67,35,0.08)] hover:-translate-y-0.5 flex flex-col justify-between h-[160px] border border-outline-variant/30">
        <div class="flex justify-between items-start">
            <div class="flex items-center gap-2 text-primary">
                <span class="material-symbols-outlined icon-filled">flag</span>
                <h3 class="font-label-bold text-label-bold uppercase">Meta de ahorro</h3>
            </div>
            <span class="material-symbols-outlined text-outline-variant" style="font-size: 40px; opacity: 0.5;">emoji_events</span>
        </div>
        <div class="flex flex-col gap-3 mt-auto">
            <a asp-controller="Goal" asp-action="Index" class="group">
                <div class="flex items-baseline gap-2">
                    <span class="font-headline-lg text-headline-lg text-on-surface">—</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant group-hover:text-accent transition-colors">Ver mis metas</span>
                </div>
                <div class="w-full h-2 bg-surface-variant rounded-full overflow-hidden mt-3">
                    <div class="h-full bg-primary/30 rounded-full" style="width: 0%;"></div>
                </div>
            </a>
        </div>
    </article>
</section>

@if (Model.HasExpenses)
{
    <!-- Charts Section -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-card-gap">
        <!-- Balance (Ingresos vs Gastos) -->
        <article class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient flex flex-col gap-6">
            <div class="flex items-center justify-between">
                <h3 class="font-headline-lg text-headline-lg text-on-surface">Balance (Ingresos vs Gastos)</h3>
                <span class="material-symbols-outlined text-outline">compare_arrows</span>
            </div>
            <div class="flex flex-col md:flex-row items-center justify-center gap-8 py-4">
                <!-- Donut: Gastos -->
                <div class="relative w-40 h-40">
                    <canvas id="expenseDonut" role="img"
                            aria-label="Gráfico de dona con tus gastos totales del mes"></canvas>
                </div>
                <!-- Donut: Ingresos -->
                <div class="relative w-40 h-40">
                    <canvas id="incomeDonut" role="img"
                            aria-label="Gráfico de dona con tus ingresos totales del mes"></canvas>
                </div>
            </div>
            <p class="sr-only">
                Ingresos: @Model.CurrencySymbol@Model.TotalIncome.ToString("N2").
                Gastos: @Model.CurrencySymbol@Model.TotalSpent.ToString("N2").
            </p>
        </article>

        <!-- Tendencia (Ingresos vs Gastos) -->
        <article class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient flex flex-col gap-6">
            <div class="flex items-center justify-between">
                <div class="flex flex-col">
                    <h3 class="font-headline-lg text-headline-lg text-on-surface">Tendencia (Ingresos vs Gastos)</h3>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">(30 días)</span>
                </div>
                <span class="material-symbols-outlined text-outline">trending_up</span>
            </div>
            <div class="relative w-full h-48 mt-4">
                <canvas id="trendChart" role="img"
                        aria-label="Gráfico de línea con ingresos y gastos diarios de los últimos 30 días"></canvas>
            </div>
            <p class="sr-only">Tendencia diaria de ingresos y gastos de los últimos 30 días.</p>
        </article>
    </section>
}
else
{
    <!-- Estado vacío -->
    <section class="bg-surface-container-lowest rounded-[16px] p-container-padding shadow-ambient border-2 border-dashed border-outline-variant text-center" aria-label="Aún no hay gastos registrados">
        <div class="w-16 h-16 mx-auto rounded-full bg-primary-container/10 flex items-center justify-center mb-4" aria-hidden="true">
            <span class="material-symbols-outlined text-primary" style="font-size: 32px;">account_balance_wallet</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Aquí no hay nada... ¡todavía!</h2>
        <p class="mt-2 font-body-md text-body-md text-on-surface-variant max-w-md mx-auto">
            Cuando registres tu primer gasto, esta sección cobrará vida con gráficas
            de a dónde va tu dinero. Empieza anotando ese café de hoy.
        </p>
        <div class="flex items-center justify-center gap-4 mt-6 flex-wrap">
            <a asp-controller="Expense" asp-action="Create" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
               class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-6 py-3 rounded-full font-label-md text-label-md font-bold hover:opacity-90 transition-opacity">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                Registrar mi primer gasto
            </a>
            <a asp-controller="Income" asp-action="Create" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
               class="inline-flex items-center gap-2 bg-transparent border-2 border-secondary text-secondary px-6 py-3 rounded-full font-label-md text-label-md hover:bg-secondary/5 transition-colors">
                <span class="material-symbols-outlined" style="font-size: 18px;">trending_up</span>
                Registrar ingreso
            </a>
        </div>
    </section>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            const catLabels = @Html.Raw(Model.LabelsCategoriaJson);
            const catValues = @Html.Raw(Model.ValoresCategoriaJson);
            const catColors = @Html.Raw(Model.ColoresCategoriaJson);
            const dayLabels = @Html.Raw(Model.LabelsDiasJson);
            const dayValues = @Html.Raw(Model.ValoresDiasJson);
            const incomeDayValues = @Html.Raw(Model.ValoresIngresosDiasJson);
            const totalIncome = @Model.TotalIncome;
            const totalSpent = @Model.TotalSpent;

            Chart.defaults.font.family = 'Plus Jakarta Sans, system-ui, sans-serif';
            Chart.defaults.color = '#404941';

            // --- Donut: Gastos por categoría ---
            const expenseDonutCanvas = document.getElementById('expenseDonut');
            if (expenseDonutCanvas && catLabels.length > 0) {
                new Chart(expenseDonutCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catValues,
                            backgroundColor: catColors,
                            borderWidth: 3,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        cutout: '65%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                        const pct = total > 0 ? ((ctx.parsed / total) * 100).toFixed(0) : 0;
                                        return ' ' + ctx.label + ': ' + ctx.parsed.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (' + pct + '%)';
                                    }
                                }
                            }
                        }
                    },
                    plugins: [{
                        id: 'centerText',
                        afterDraw: function (chart) {
                            const { ctx, chartArea } = chart;
                            const centerX = (chartArea.left + chartArea.right) / 2;
                            const centerY = (chartArea.top + chartArea.bottom) / 2;
                            ctx.save();
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.font = 'bold 18px Manrope';
                            ctx.fillStyle = '#ba1a1a';
                            ctx.fillText('$' + totalSpent.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }), centerX, centerY - 8);
                            ctx.font = '500 12px Plus Jakarta Sans';
                            ctx.fillStyle = '#404941';
                            ctx.fillText('Gastos', centerX, centerY + 12);
                            ctx.restore();
                        }
                    }]
                });
            }

            // --- Donut: Ingresos ---
            const incomeDonutCanvas = document.getElementById('incomeDonut');
            if (incomeDonutCanvas) {
                new Chart(incomeDonutCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: ['Ingresos'],
                        datasets: [{
                            data: [totalIncome],
                            backgroundColor: ['#004323'],
                            borderWidth: 3,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        cutout: '65%',
                        plugins: {
                            legend: { display: false },
                            tooltip: { enabled: false }
                        }
                    },
                    plugins: [{
                        id: 'centerText',
                        afterDraw: function (chart) {
                            const { ctx, chartArea } = chart;
                            const centerX = (chartArea.left + chartArea.right) / 2;
                            const centerY = (chartArea.top + chartArea.bottom) / 2;
                            ctx.save();
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.font = 'bold 18px Manrope';
                            ctx.fillStyle = '#004323';
                            ctx.fillText('$' + totalIncome.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }), centerX, centerY - 8);
                            ctx.font = '500 12px Plus Jakarta Sans';
                            ctx.fillStyle = '#404941';
                            ctx.fillText('Ingresos', centerX, centerY + 12);
                            ctx.restore();
                        }
                    }]
                });
            }

            // --- Line Chart: Tendencia Ingresos vs Gastos ---
            const lineCanvas = document.getElementById('trendChart');
            if (lineCanvas) {
                new Chart(lineCanvas, {
                    type: 'line',
                    data: {
                        labels: dayLabels,
                        datasets: [
                            {
                                label: 'Ingresos del día',
                                data: incomeDayValues,
                                borderColor: '#004323',
                                backgroundColor: function (ctx) {
                                    const chart = ctx.chart;
                                    const { ctx: canvasCtx, chartArea } = chart;
                                    if (!chartArea) return 'rgba(0, 67, 35, 0.1)';
                                    const gradient = canvasCtx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
                                    gradient.addColorStop(0, 'rgba(0, 67, 35, 0)');
                                    gradient.addColorStop(1, 'rgba(0, 67, 35, 0.15)');
                                    return gradient;
                                },
                                fill: true,
                                tension: 0.4,
                                pointRadius: 3,
                                pointBackgroundColor: '#004323',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                borderWidth: 3
                            },
                            {
                                label: 'Gastos del día',
                                data: dayValues,
                                borderColor: '#ba1a1a',
                                backgroundColor: function (ctx) {
                                    const chart = ctx.chart;
                                    const { ctx: canvasCtx, chartArea } = chart;
                                    if (!chartArea) return 'rgba(186, 26, 26, 0.1)';
                                    const gradient = canvasCtx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
                                    gradient.addColorStop(0, 'rgba(186, 26, 26, 0)');
                                    gradient.addColorStop(1, 'rgba(186, 26, 26, 0.15)');
                                    return gradient;
                                },
                                fill: true,
                                tension: 0.4,
                                pointRadius: 3,
                                pointBackgroundColor: '#ba1a1a',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                borderWidth: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    padding: 16,
                                    font: { family: 'Plus Jakarta Sans', size: 12 }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#e5f0eb' },
                                border: { display: false }
                            },
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: { maxTicksLimit: 8 }
                            }
                        },
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        }
                    }
                });
            }
        })();
    </script>
}
