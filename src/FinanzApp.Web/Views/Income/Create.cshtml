@model FinanzApp.Web.ViewModels.IncomeFormViewModel
@using FinanzApp.Web.Models
@{
    ViewData["Title"] = "Registrar Ingreso";
}

<div class="max-w-md mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-secondary-dark text-center">
        Registrar ingreso
    </h1>
    <p class="mt-2 text-secondary text-center text-sm sm:text-base">
        Registra el dinero que recibes y mantén tus finanzas claras.
    </p>

    <form asp-action="Create" method="post"
          class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8 space-y-5"
          novalidate aria-label="Formulario para registrar un ingreso">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 border border-red-200 rounded-lg p-3" role="alert"></div>

        <div>
            <label asp-for="Amount" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <div class="relative">
                <input asp-for="Amount" type="number" step="0.01" min="0.01"
                       inputmode="decimal"
                       class="w-full rounded-xl border border-slate-300 px-4 py-3.5 text-lg font-bold text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                       placeholder="0.00" />
            </div>
            <span asp-validation-for="Amount" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Category" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<IncomeCategory>()"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3.5 text-lg text-secondary-dark bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent">
                <option value="" disabled selected>¿De dónde vino el ingreso?</option>
            </select>
            <span asp-validation-for="Category" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Date" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <input asp-for="Date" type="date"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3.5 text-secondary-dark bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent" />
            <span asp-validation-for="Date" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Note" class="block text-sm font-semibold text-secondary-dark mb-1"></label>
            <textarea asp-for="Note" rows="3" maxlength="500"
                      class="w-full rounded-xl border border-slate-300 px-4 py-3 text-secondary-dark placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent resize-y"
                      placeholder="Ej. beca de semestre, mesada de enero"></textarea>
            <span asp-validation-for="Note" class="text-red-500 text-sm mt-1 block"></span>
        </div>

        <button type="submit"
                class="w-full bg-secondary hover:bg-secondary-dark transition-colors text-white font-bold text-lg py-3.5 rounded-xl focus:outline-none focus:ring-4 focus:ring-secondary/40">
            Guardar ingreso
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-secondary">
        <a asp-controller="Dashboard" asp-action="Index" class="font-bold text-accent hover:text-accent-dark focus:outline-none focus:underline">
            Volver al panel
        </a>
    </p>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
