<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_5"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="FinanzApp"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_5">
    <bpmn:participant id="Participant_GoalUser" name="Estudiante" processRef="Process_Goal_User" />
    <bpmn:participant id="Participant_GoalBackend" name="FinanzApp Backend" processRef="Process_Goal_System" />
  </bpmn:collaboration>

  <!-- ==================== PROCESO: METAS DE AHORRO (US5) ==================== -->
  <bpmn:process id="Process_Goal_User" name="Metas de Ahorro" isExecutable="false">

    <bpmn:startEvent id="Start_OpenGoals" name="Abrir sección de metas">
      <bpmn:outgoing>Flow_G01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ViewGoals" name="Ver metas existentes&#10;(lista de tarjetas con progreso)">
      <bpmn:incoming>Flow_G01</bpmn:incoming>
      <bpmn:outgoing>Flow_G02</bpmn:outgoing>
    </bpmn:task>

    <!-- ¿Tiene metas? -->
    <bpmn:exclusiveGateway id="GW_HasGoals" name="¿Tiene metas?">
      <bpmn:incoming>Flow_G02</bpmn:incoming>
      <bpmn:outgoing>Flow_G03a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sin metas -->
    <bpmn:task id="Task_EmptyGoals" name="Mostrar estado vacío&#10;('Crea tu primera meta de ahorro')">
      <bpmn:incoming>Flow_G03b</bpmn:incoming>
      <bpmn:outgoing>Flow_G04</bpmn:outgoing>
    </bpmn:task>

    <!-- Crear meta -->
    <bpmn:exclusiveGateway id="GW_CreateGoal" name="¿Crear meta?">
      <bpmn:incoming>Flow_G04</bpmn:incoming>
      <bpmn:outgoing>Flow_G05a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G05b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CreateGoalForm" name="Completar formulario:&#10;nombre + monto + fecha límite">
      <bpmn:incoming>Flow_G05a</bpmn:incoming>
      <bpmn:outgoing>Flow_G06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_GoalValid" name="¿Datos válidos?&#10;(monto > 0, fecha futura)">
      <bpmn:incoming>Flow_G06</bpmn:incoming>
      <bpmn:outgoing>Flow_G07a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G07b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_GoalError" name="Mostrar error&#10;(ej: 'La fecha debe ser futura')">
      <bpmn:incoming>Flow_G07b</bpmn:incoming>
      <bpmn:outgoing>Flow_G08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_GoalSaved" name="Meta creada&#10;(progreso: 0%)">
      <bpmn:incoming>Flow_G07a</bpmn:incoming>
      <bpmn:outgoing>Flow_G09</bpmn:outgoing>
    </bpmn:task>

    <!-- Ver metas -->
    <bpmn:task id="Task_ViewGoalCards" name="Ver metas con:&#10;barra de progreso + proyección">
      <bpmn:incoming>Flow_G03a</bpmn:incoming>
      <bpmn:incoming>Flow_G09</bpmn:incoming>
      <bpmn:outgoing>Flow_G10</bpmn:outgoing>
    </bpmn:task>

    <!-- Acciones -->
    <bpmn:exclusiveGateway id="GW_GoalAction" name="¿Qué hacer?">
      <bpmn:incoming>Flow_G10</bpmn:incoming>
      <bpmn:outgoing>Flow_G11a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G11b</bpmn:outgoing>
      <bpmn:outgoing>Flow_G11c</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Agregar ahorro -->
    <bpmn:task id="Task_AddSavings" name="Presionar 'Agregar Ahorro'&#10;(ingresar monto)">
      <bpmn:incoming>Flow_G11a</bpmn:incoming>
      <bpmn:outgoing>Flow_G12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SaveContribution" name="Confirmar ahorro&#10;(fecha: hoy, monto > 0)">
      <bpmn:incoming>Flow_G12</bpmn:incoming>
      <bpmn:outgoing>Flow_G13</bpmn:outgoing>
    </bpmn:task>

    <!-- Verificar completada -->
    <bpmn:exclusiveGateway id="GW_GoalComplete" name="¿Meta alcanzada?&#10;(total ahorrado ≥ objetivo)">
      <bpmn:incoming>Flow_G13</bpmn:incoming>
      <bpmn:outgoing>Flow_G14a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G14b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_GoalCompleted" name="¡Meta completada!&#10;(barra: 100%, celebración)">
      <bpmn:incoming>Flow_G14a</bpmn:incoming>
      <bpmn:outgoing>Flow_G15</bpmn:outgoing>
    </bpmn:task>

    <!-- Verificar proyección -->
    <bpmn:exclusiveGateway id="GW_WillReach" name="¿Alcanzará la meta?&#10;(proyección actual)">
      <bpmn:incoming>Flow_G14b</bpmn:incoming>
      <bpmn:incoming>Flow_G15</bpmn:incoming>
      <bpmn:outgoing>Flow_G16a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G16b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ProjectionOK" name="Mostrar proyección positiva&#10;('¡Vas bien!')">
      <bpmn:incoming>Flow_G16a</bpmn:incoming>
      <bpmn:outgoing>Flow_G17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ProjectionOff" name="Mostrar sugerencia&#10;('Necesitas ahorrar $X más por mes')">
      <bpmn:incoming>Flow_G16b</bpmn:incoming>
      <bpmn:outgoing>Flow_G17</bpmn:outgoing>
    </bpmn:task>

    <!-- Ver proyección -->
    <bpmn:task id="Task_ViewProjection" name="Ver proyección en la tarjeta">
      <bpmn:incoming>Flow_G11b</bpmn:incoming>
      <bpmn:incoming>Flow_G17</bpmn:incoming>
      <bpmn:outgoing>Flow_G18</bpmn:outgoing>
    </bpmn:task>

    <!-- Más acciones -->
    <bpmn:exclusiveGateway id="GW_MoreActions" name="¿Más acciones?">
      <bpmn:incoming>Flow_G18</bpmn:incoming>
      <bpmn:outgoing>Flow_G19a</bpmn:outgoing>
      <bpmn:outgoing>Flow_G19b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NewGoal" name="Crear otra meta">
      <bpmn:incoming>Flow_G19a</bpmn:incoming>
      <bpmn:outgoing>Flow_G20</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Goals" name="Operación completada">
      <bpmn:incoming>Flow_G19b</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flujos -->
    <bpmn:sequenceFlow id="Flow_G01" sourceRef="Start_OpenGoals" targetRef="Task_ViewGoals" />
    <bpmn:sequenceFlow id="Flow_G02" sourceRef="Task_ViewGoals" targetRef="GW_HasGoals" />
    <bpmn:sequenceFlow id="Flow_G03a" name="Sí" sourceRef="GW_HasGoals" targetRef="Task_ViewGoalCards" />
    <bpmn:sequenceFlow id="Flow_G03b" name="No" sourceRef="GW_HasGoals" targetRef="Task_EmptyGoals" />
    <bpmn:sequenceFlow id="Flow_G04" sourceRef="Task_EmptyGoals" targetRef="GW_CreateGoal" />
    <bpmn:sequenceFlow id="Flow_G05a" name="Sí" sourceRef="GW_CreateGoal" targetRef="Task_CreateGoalForm" />
    <bpmn:sequenceFlow id="Flow_G05b" name="No" sourceRef="GW_CreateGoal" targetRef="End_Goals" />
    <bpmn:sequenceFlow id="Flow_G06" sourceRef="Task_CreateGoalForm" targetRef="GW_GoalValid" />
    <bpmn:sequenceFlow id="Flow_G07a" name="Válido" sourceRef="GW_GoalValid" targetRef="Task_GoalSaved" />
    <bpmn:sequenceFlow id="Flow_G07b" name="Inválido" sourceRef="GW_GoalValid" targetRef="Task_GoalError" />
    <bpmn:sequenceFlow id="Flow_G08" sourceRef="Task_GoalError" targetRef="Task_CreateGoalForm" />
    <bpmn:sequenceFlow id="Flow_G09" sourceRef="Task_GoalSaved" targetRef="Task_ViewGoalCards" />
    <bpmn:sequenceFlow id="Flow_G10" sourceRef="Task_ViewGoalCards" targetRef="GW_GoalAction" />
    <bpmn:sequenceFlow id="Flow_G11a" name="Agregar ahorro" sourceRef="GW_GoalAction" targetRef="Task_AddSavings" />
    <bpmn:sequenceFlow id="Flow_G11b" name="Ver proyección" sourceRef="GW_GoalAction" targetRef="Task_ViewProjection" />
    <bpmn:sequenceFlow id="Flow_G11c" name="Crear meta" sourceRef="GW_GoalAction" targetRef="Task_CreateGoalForm" />
    <bpmn:sequenceFlow id="Flow_G12" sourceRef="Task_AddSavings" targetRef="Task_SaveContribution" />
    <bpmn:sequenceFlow id="Flow_G13" sourceRef="Task_SaveContribution" targetRef="GW_GoalComplete" />
    <bpmn:sequenceFlow id="Flow_G14a" name="Sí" sourceRef="GW_GoalComplete" targetRef="Task_GoalCompleted" />
    <bpmn:sequenceFlow id="Flow_G14b" name="No" sourceRef="GW_GoalComplete" targetRef="GW_WillReach" />
    <bpmn:sequenceFlow id="Flow_G15" sourceRef="Task_GoalCompleted" targetRef="GW_WillReach" />
    <bpmn:sequenceFlow id="Flow_G16a" name="Alcanzará" sourceRef="GW_WillReach" targetRef="Task_ProjectionOK" />
    <bpmn:sequenceFlow id="Flow_G16b" name="No alcanzará" sourceRef="GW_WillReach" targetRef="Task_ProjectionOff" />
    <bpmn:sequenceFlow id="Flow_G17" sourceRef="Task_ProjectionOK" targetRef="Task_ViewProjection" />
    <bpmn:sequenceFlow id="Flow_G17" sourceRef="Task_ProjectionOff" targetRef="Task_ViewProjection" />
    <bpmn:sequenceFlow id="Flow_G18" sourceRef="Task_ViewProjection" targetRef="GW_MoreActions" />
    <bpmn:sequenceFlow id="Flow_G19a" name="Sí" sourceRef="GW_MoreActions" targetRef="Task_NewGoal" />
    <bpmn:sequenceFlow id="Flow_G19b" name="No" sourceRef="GW_MoreActions" targetRef="End_Goals" />
    <bpmn:sequenceFlow id="Flow_G20" sourceRef="Task_NewGoal" targetRef="Task_CreateGoalForm" />

  </bpmn:process>

  <!-- ==================== PROCESO BACKEND ==================== -->
  <bpmn:process id="Process_Goal_System" name="Backend Goals API" isExecutable="false">
    <bpmn:task id="Task_API_GetGoals" name="GET /api/goals&#10;(listar metas con progreso)" />
    <bpmn:task id="Task_API_CreateGoal" name="POST /api/goals&#10;(validar fecha futura, crear)" />
    <bpmn:task id="Task_API_AddEntry" name="POST /api/goals/{id}/entries&#10;(agregar ahorro)" />
    <bpmn:task id="Task_API_CalcProjection" name="Calcular proyección&#10;(ahorro mensual × tiempo restante)" />
  </bpmn:process>

  <!-- ==================== DIAGRAMA ==================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_5">
    <bpmndi:BPMNPlane id="BPMNPlane_5" bpmnElement="Collaboration_5">

      <bpmndi:BPMNShape id="Shape_Participant_GoalUser" bpmnElement="Participant_GoalUser" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1500" height="620" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_GoalBackend" bpmnElement="Participant_GoalBackend" isHorizontal="true">
        <dc:Bounds x="160" y="720" width="1500" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_OpenGoals">
        <dc:Bounds x="200" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewGoals" bpmnElement="Task_ViewGoals">
        <dc:Bounds x="290" y="290" width="150" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_HasGoals" bpmnElement="GW_HasGoals" isMarkerVisible="true">
        <dc:Bounds x="485" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EmptyGoals" bpmnElement="Task_EmptyGoals">
        <dc:Bounds x="460" y="400" width="180" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_CreateGoal" bpmnElement="GW_CreateGoal" isMarkerVisible="true">
        <dc:Bounds x="555" y="485" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_CreateGoalForm" bpmnElement="Task_CreateGoalForm">
        <dc:Bounds x="580" y="290" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_Valid" bpmnElement="GW_GoalValid" isMarkerVisible="true">
        <dc:Bounds x="805" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GoalError" bpmnElement="Task_GoalError">
        <dc:Bounds x="780" y="400" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GoalSaved" bpmnElement="Task_GoalSaved">
        <dc:Bounds x="900" y="290" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewGoalCards" bpmnElement="Task_ViewGoalCards">
        <dc:Bounds x="1080" y="290" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_Action" bpmnElement="GW_GoalAction" isMarkerVisible="true">
        <dc:Bounds x="1295" y="305" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_AddSavings" bpmnElement="Task_AddSavings">
        <dc:Bounds x="1300" y="200" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SaveContribution" bpmnElement="Task_SaveContribution">
        <dc:Bounds x="1300" y="400" width="170" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_Complete" bpmnElement="GW_GoalComplete" isMarkerVisible="true">
        <dc:Bounds x="1345" y="490" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GoalCompleted" bpmnElement="Task_GoalCompleted">
        <dc:Bounds x="1340" y="560" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_WillReach" bpmnElement="GW_WillReach" isMarkerVisible="true">
        <dc:Bounds x="1445" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ProjectionOK" bpmnElement="Task_ProjectionOK">
        <dc:Bounds x="1450" y="300" width="170" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ProjectionOff" bpmnElement="Task_ProjectionOff">
        <dc:Bounds x="1450" y="500" width="180" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewProjection" bpmnElement="Task_ViewProjection">
        <dc:Bounds x="1450" y="200" width="170" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_More" bpmnElement="GW_MoreActions" isMarkerVisible="true">
        <dc:Bounds x="1545" y="120" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_NewGoal" bpmnElement="Task_NewGoal">
        <dc:Bounds x="1600" y="200" width="120" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End_Goals">
        <dc:Bounds x="1622" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Edge_Flow_G01" bpmnElement="Flow_G01">
        <di:waypoint x="236" y="330" />
        <di:waypoint x="290" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G02" bpmnElement="Flow_G02">
        <di:waypoint x="440" y="330" />
        <di:waypoint x="485" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G03a" bpmnElement="Flow_G03a">
        <di:waypoint x="535" y="330" />
        <di:waypoint x="1080" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G03b" bpmnElement="Flow_G03b">
        <di:waypoint x="510" y="355" />
        <di:waypoint x="510" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G04" bpmnElement="Flow_G04">
        <di:waypoint x="550" y="430" />
        <di:waypoint x="555" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G05a" bpmnElement="Flow_G05a">
        <di:waypoint x="580" y="510" />
        <di:waypoint x="670" y="510" />
        <di:waypoint x="670" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G05b" bpmnElement="Flow_G05b">
        <di:waypoint x="605" y="535" />
        <di:waypoint x="605" y="570" />
        <di:waypoint x="1622" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G06" bpmnElement="Flow_G06">
        <di:waypoint x="760" y="330" />
        <di:waypoint x="805" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G07a" bpmnElement="Flow_G07a">
        <di:waypoint x="855" y="330" />
        <di:waypoint x="900" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G07b" bpmnElement="Flow_G07b">
        <di:waypoint x="830" y="355" />
        <di:waypoint x="830" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G08" bpmnElement="Flow_G08">
        <di:waypoint x="780" y="430" />
        <di:waypoint x="670" y="430" />
        <di:waypoint x="670" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G09" bpmnElement="Flow_G09">
        <di:waypoint x="1040" y="330" />
        <di:waypoint x="1080" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G10" bpmnElement="Flow_G10">
        <di:waypoint x="1260" y="330" />
        <di:waypoint x="1295" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G11a" bpmnElement="Flow_G11a">
        <di:waypoint x="1320" y="305" />
        <di:waypoint x="1320" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G11b" bpmnElement="Flow_G11b">
        <di:waypoint x="1345" y="330" />
        <di:waypoint x="1450" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G11c" bpmnElement="Flow_G11c">
        <di:waypoint x="1320" y="355" />
        <di:waypoint x="1320" y="380" />
        <di:waypoint x="670" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G12" bpmnElement="Flow_G12">
        <di:waypoint x="1380" y="260" />
        <di:waypoint x="1380" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G13" bpmnElement="Flow_G13">
        <di:waypoint x="1385" y="460" />
        <di:waypoint x="1385" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G14a" bpmnElement="Flow_G14a">
        <di:waypoint x="1370" y="540" />
        <di:waypoint x="1370" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G14b" bpmnElement="Flow_G14b">
        <di:waypoint x="1395" y="490" />
        <di:waypoint x="1445" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G15" bpmnElement="Flow_G15">
        <di:waypoint x="1420" y="560" />
        <di:waypoint x="1420" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G16a" bpmnElement="Flow_G16a">
        <di:waypoint x="1470" y="405" />
        <di:waypoint x="1470" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G16b" bpmnElement="Flow_G16b">
        <di:waypoint x="1470" y="455" />
        <di:waypoint x="1470" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G17a" bpmnElement="Flow_G17" sourceRef="Task_ProjectionOK">
        <di:waypoint x="1535" y="300" />
        <di:waypoint x="1535" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G17b" bpmnElement="Flow_G17" sourceRef="Task_ProjectionOff">
        <di:waypoint x="1540" y="500" />
        <di:waypoint x="1540" y="460" />
        <di:waypoint x="1540" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G18" bpmnElement="Flow_G18">
        <di:waypoint x="1535" y="200" />
        <di:waypoint x="1535" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_G19a" bpmnElement="Flow_G19a">
        <di:waypoint x="1570" y="120" />
        <di:waypoint x="1600" y="225" />
