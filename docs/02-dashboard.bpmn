<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_2"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="FinanzApp"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_2">
    <bpmn:participant id="Participant_Student" name="Estudiante" processRef="Process_Dashboard_User" />
    <bpmn:participant id="Participant_App" name="FinanzApp Backend" processRef="Process_Dashboard_System" />
  </bpmn:collaboration>

  <!-- ==================== PROCESO: DASHBOARD (US2) ==================== -->
  <bpmn:process id="Process_Dashboard_User" name="Dashboard Overview" isExecutable="false">

    <bpmn:startEvent id="Start_OpenApp" name="Abrir app / navegar a dashboard">
      <bpmn:outgoing>Flow_D01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_LoadDashboard" name="Cargar dashboard&#10;(resumen + gráficas + presupuesto)">
      <bpmn:incoming>Flow_D01</bpmn:incoming>
      <bpmn:outgoing>Flow_D02</bpmn:outgoing>
    </bpmn:task>

    <!-- Decisión: ¿Tiene datos? -->
    <bpmn:exclusiveGateway id="GW_HasData" name="¿Tiene datos?">
      <bpmn:incoming>Flow_D02</bpmn:incoming>
      <bpmn:outgoing>Flow_D03a</bpmn:outgoing>
      <bpmn:outgoing>Flow_D03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sin datos -->
    <bpmn:task id="Task_EmptyState" name="Mostrar estados vacíos&#10;(guía para comenzar)">
      <bpmn:incoming>Flow_D03b</bpmn:incoming>
      <bpmn:outgoing>Flow_D04</bpmn:outgoing>
    </bpmn:task>

    <!-- Con datos -->
    <bpmn:task id="Task_ViewSummary" name="Ver resumen:&#10;gasto total, saldo, ahorro">
      <bpmn:incoming>Flow_D03a</bpmn:incoming>
      <bpmn:outgoing>Flow_D05</bpmn:outgoing>
    </bpmn:task>

    <!-- Ver gráficas -->
    <bpmn:task id="Task_ViewCharts" name="Ver gráficas:&#10;donut (categorías) + línea (tendencia)">
      <bpmn:incoming>Flow_D05</bpmn:incoming>
      <bpmn:outgoing>Flow_D06</bpmn:outgoing>
    </bpmn:task>

    <!-- Decisión: ¿Tiene presupuesto? -->
    <bpmn:exclusiveGateway id="GW_HasBudget" name="¿Tiene presupuesto?">
      <bpmn:incoming>Flow_D06</bpmn:incoming>
      <bpmn:outgoing>Flow_D07a</bpmn:outgoing>
      <bpmn:outgoing>Flow_D07b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sin presupuesto -->
    <bpmn:task id="Task_SetBudget" name="Configurar presupuesto&#10;(edición en línea: 'Establecer Presupuesto')">
      <bpmn:incoming>Flow_D07b</bpmn:incoming>
      <bpmn:outgoing>Flow_D08</bpmn:outgoing>
    </bpmn:task>

    <!-- Con presupuesto -->
    <bpmn:task id="Task_ViewRemaining" name="Ver saldo restante&#10;(presupuesto - gastos)">
      <bpmn:incoming>Flow_D07a</bpmn:incoming>
      <bpmn:outgoing>Flow_D09</bpmn:outgoing>
    </bpmn:task>

    <!-- Editar presupuesto (opcional) -->
    <bpmn:task id="Task_EditBudget" name="Editar presupuesto (opcional)&#10;(toque en el monto)">
      <bpmn:incoming>Flow_D09</bpmn:incoming>
      <bpmn:outgoing>Flow_D10</bpmn:outgoing>
    </bpmn:task>

    <!-- Navegación -->
    <bpmn:exclusiveGateway id="GW_Navigate" name="¿Navegar a otra sección?">
      <bpmn:incoming>Flow_D08</bpmn:incoming>
      <bpmn:incoming>Flow_D10</bpmn:incoming>
      <bpmn:outgoing>Flow_D11a</bpmn:outgoing>
      <bpmn:outgoing>Flow_D11b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_GoExpenses" name="Ir a Gastos&#10;(registrar / editar / eliminar)">
      <bpmn:incoming>Flow_D11a</bpmn:incoming>
      <bpmn:outgoing>Flow_D12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Dashboard" name="Dashboard actualizado">
      <bpmn:incoming>Flow_D04</bpmn:incoming>
      <bpmn:incoming>Flow_D11b</bpmn:incoming>
      <bpmn:incoming>Flow_D12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Flujos -->
    <bpmn:sequenceFlow id="Flow_D01" sourceRef="Start_OpenApp" targetRef="Task_LoadDashboard" />
    <bpmn:sequenceFlow id="Flow_D02" sourceRef="Task_LoadDashboard" targetRef="GW_HasData" />
    <bpmn:sequenceFlow id="Flow_D03a" name="Sí" sourceRef="GW_HasData" targetRef="Task_ViewSummary" />
    <bpmn:sequenceFlow id="Flow_D03b" name="No" sourceRef="GW_HasData" targetRef="Task_EmptyState" />
    <bpmn:sequenceFlow id="Flow_D04" sourceRef="Task_EmptyState" targetRef="End_Dashboard" />
    <bpmn:sequenceFlow id="Flow_D05" sourceRef="Task_ViewSummary" targetRef="Task_ViewCharts" />
    <bpmn:sequenceFlow id="Flow_D06" sourceRef="Task_ViewCharts" targetRef="GW_HasBudget" />
    <bpmn:sequenceFlow id="Flow_D07a" name="Sí" sourceRef="GW_HasBudget" targetRef="Task_ViewRemaining" />
    <bpmn:sequenceFlow id="Flow_D07b" name="No" sourceRef="GW_HasBudget" targetRef="Task_SetBudget" />
    <bpmn:sequenceFlow id="Flow_D08" sourceRef="Task_SetBudget" targetRef="GW_Navigate" />
    <bpmn:sequenceFlow id="Flow_D09" sourceRef="Task_ViewRemaining" targetRef="Task_EditBudget" />
    <bpmn:sequenceFlow id="Flow_D10" sourceRef="Task_EditBudget" targetRef="GW_Navigate" />
    <bpmn:sequenceFlow id="Flow_D11a" name="Sí (Gastos)" sourceRef="GW_Navigate" targetRef="Task_GoExpenses" />
    <bpmn:sequenceFlow id="Flow_D11b" name="No" sourceRef="GW_Navigate" targetRef="End_Dashboard" />
    <bpmn:sequenceFlow id="Flow_D12" sourceRef="Task_GoExpenses" targetRef="End_Dashboard" />

  </bpmn:process>

  <!-- ==================== PROCESO SISTEMÁTICO ==================== -->
  <bpmn:process id="Process_Dashboard_System" name="Backend API" isExecutable="false">
    <bpmn:task id="Task_API_Dashboard" name="GET /api/dashboard&#10;(agregar gastos, calcular totales)" />
    <bpmn:task id="Task_API_Budget" name="PUT /api/budget&#10;(guardar/modificar presupuesto)" />
  </bpmn:process>

  <!-- ==================== DIAGRAMA ==================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_2">

      <bpmndi:BPMNShape id="Shape_Participant_Student" bpmnElement="Participant_Student" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1100" height="400" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_App" bpmnElement="Participant_App" isHorizontal="true">
        <dc:Bounds x="160" y="520" width="1100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_OpenApp">
        <dc:Bounds x="200" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_LoadDashboard" bpmnElement="Task_LoadDashboard">
        <dc:Bounds x="290" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_HasData" bpmnElement="GW_HasData" isMarkerVisible="true">
        <dc:Bounds x="480" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EmptyState" bpmnElement="Task_EmptyState">
        <dc:Bounds x="465" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewSummary" bpmnElement="Task_ViewSummary">
        <dc:Bounds x="580" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewCharts" bpmnElement="Task_ViewCharts">
        <dc:Bounds x="760" y="220" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_HasBudget" bpmnElement="GW_HasBudget" isMarkerVisible="true">
        <dc:Bounds x="940" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SetBudget" bpmnElement="Task_SetBudget">
        <dc:Bounds x="920" y="340" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_ViewRemaining" bpmnElement="Task_ViewRemaining">
        <dc:Bounds x="1040" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EditBudget" bpmnElement="Task_EditBudget">
        <dc:Bounds x="1040" y="260" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_Navigate" bpmnElement="GW_Navigate" isMarkerVisible="true">
        <dc:Bounds x="1140" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GoExpenses" bpmnElement="Task_GoExpenses">
        <dc:Bounds x="1140" y="440" width="140" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End_Dashboard">
        <dc:Bounds x="1242" y="380" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Edge_Flow_D01" bpmnElement="Flow_D01">
        <di:waypoint x="236" y="260" />
        <di:waypoint x="290" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D02" bpmnElement="Flow_D02">
        <di:waypoint x="430" y="260" />
        <di:waypoint x="480" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D03a" bpmnElement="Flow_D03a">
        <di:waypoint x="530" y="260" />
        <di:waypoint x="580" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D03b" bpmnElement="Flow_D03b">
        <di:waypoint x="505" y="285" />
        <di:waypoint x="505" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D04" bpmnElement="Flow_D04">
        <di:waypoint x="605" y="380" />
        <di:waypoint x="1242" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D05" bpmnElement="Flow_D05">
        <di:waypoint x="720" y="260" />
        <di:waypoint x="760" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D06" bpmnElement="Flow_D06">
        <di:waypoint x="900" y="260" />
        <di:waypoint x="940" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D07a" bpmnElement="Flow_D07a">
        <di:waypoint x="990" y="260" />
        <di:waypoint x="1040" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D07b" bpmnElement="Flow_D07b">
        <di:waypoint x="965" y="285" />
        <di:waypoint x="965" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D08" bpmnElement="Flow_D08">
        <di:waypoint x="1000" y="380" />
        <di:waypoint x="1140" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D09" bpmnElement="Flow_D09">
        <di:waypoint x="1110" y="260" />
        <di:waypoint x="1110" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D10" bpmnElement="Flow_D10">
        <di:waypoint x="1120" y="300" />
        <di:waypoint x="1140" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D11a" bpmnElement="Flow_D11a">
        <di:waypoint x="1165" y="415" />
        <di:waypoint x="1165" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D11b" bpmnElement="Flow_D11b">
        <di:waypoint x="1190" y="390" />
        <di:waypoint x="1242" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_D12" bpmnElement="Flow_D12">
        <di:waypoint x="1280" y="470" />
        <di:waypoint x="1280" y="398" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
